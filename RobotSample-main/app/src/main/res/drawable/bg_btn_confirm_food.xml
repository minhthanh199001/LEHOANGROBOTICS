<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#065F46"
                android:endColor="#047857"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#34D399" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#059669"
                android:endColor="#10B981"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#6EE7B7" />
        </shape>
    </item>
</selector>

