<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6D97706"
                android:endColor="#CCB45309"
                android:angle="45" />
            <stroke
                android:width="2dp"
                android:color="#FDE68A" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80D97706"
                android:endColor="#66B45309"
                android:angle="45" />
            <stroke
                android:width="1.5dp"
                android:color="#FBBF24" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
