<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#047857"
                android:endColor="#0284C7"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#059669"
                android:endColor="#0EA5E9"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#38BDF8" />
        </shape>
    </item>
</selector>

