<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D0284C7" />
            <stroke android:width="0.8dp" android:color="#8038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#260369A1" />
            <stroke android:width="0.8dp" android:color="#33BAE6FD" />
        </shape>
    </item>
</selector>

