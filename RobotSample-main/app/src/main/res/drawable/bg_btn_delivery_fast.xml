<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6059669"
                android:endColor="#CC047857"
                android:angle="45" />
            <stroke
                android:width="2dp"
                android:color="#A7F3D0" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80059669"
                android:endColor="#66047857"
                android:angle="45" />
            <stroke
                android:width="1.5dp"
                android:color="#34D399" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
