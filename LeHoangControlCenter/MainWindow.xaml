                        </StackPanel>
                        <Button Command="{Binding CloseChangePasswordDialogCommand}" Content="✕" Width="26" Height="26"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" />
                    </Grid>

                    <TextBlock Text="Mật khẩu hiện tại:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CyberTextBox}" Margin="0,0,0,12" Height="32" />

                    <TextBlock Text="Mật khẩu mới (tối thiểu 4 ký tự):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CyberTextBox}" Margin="0,0,0,12" Height="32" />

                    <TextBlock Text="Xác nhận lại mật khẩu mới:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CyberTextBox}" Margin="0,0,0,12" Height="32" />

                    <!-- Error Alert -->
                    <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12"
                            Visibility="{Binding HasChangePasswordError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ChangePasswordErrorMessage}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" />
                    </Border>

                    <!-- Success Alert -->
                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12"
                            Visibility="{Binding HasChangePasswordSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ChangePasswordSuccessMessage}" Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Command="{Binding CloseChangePasswordDialogCommand}" Content="Hủy bỏ" Style="{StaticResource CyberButton}" Background="#334155" Width="85" Margin="0,0,8,0" />
                        <Button Command="{Binding SaveChangePasswordCommand}" Content="💾 Cập Nhật Mật Khẩu" Style="{StaticResource CyanButton}" Width="165" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- VIEW: FULL-SCREEN CYBER LOGIN SCREEN                      -->
        <!-- ========================================================= -->
        <Grid Grid.ColumnSpan="3"
              Background="#F2070B14"
              Visibility="{Binding IsLoginScreenVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="460"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#0D1527"
                    BorderBrush="#00E5FF"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="35" ShadowDepth="0" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <!-- Brand Logo -->
                    <Image Source="Resources/LEHOANG.png" Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="LE HOANG ROBOTICS"
                               FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <TextBlock Text="HỆ THỐNG ĐIỀU HÀNH &amp; PHÂN QUYỀN FLEET ROBOT"
                               FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"
                               HorizontalAlignment="Center" Margin="0,0,0,18" />

                    <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,16" />

                    <!-- Username Field -->
                    <TextBlock Text="Tên đăng nhập / Tài khoản:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,5" />
                    <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CyberTextBox}" Height="34" Margin="0,0,0,12" FontSize="13" />

                    <!-- Password Field -->
                    <TextBlock Text="Mật khẩu đăng nhập:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,5" />
                    <TextBox Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CyberTextBox}" Height="34" Margin="0,0,0,14" FontSize="13" />

                    <!-- Error Alert -->
                    <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,14"
                            Visibility="{Binding HasLoginError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding LoginErrorMessage}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </Border>

                    <!-- Login Button -->
                    <Button Command="{Binding LoginCommand}"
                            Content="ĐĂNG NHẬP HỆ THỐNG"
                            Style="{StaticResource CyanButton}"
                            Height="38"
                            FontSize="12"
                            FontWeight="Bold"
                            IsDefault="True"
                            Margin="0,0,0,18" />

                    <!-- Quick Demo Credentials Helper -->
                   
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
    </Grid>



</Window>



