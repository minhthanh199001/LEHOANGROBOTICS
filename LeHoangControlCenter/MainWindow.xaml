<Window x:Class="LeHoangControlCenter.MainWindow"



        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"



        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"



        xmlns:vm="clr-namespace:LeHoangControlCenter.ViewModels"



        xmlns:models="clr-namespace:LeHoangControlCenter.Models"



        mc:Ignorable="d"



        Title="LE HOANG ROBOTICS – CONTROL CENTER"
        Icon="Resources/LEHOANG.png" 



        Height="820" Width="1440"
        MinHeight="550" MinWidth="1024"



        WindowState="Maximized"

        WindowStartupLocation="CenterScreen"



        Background="#080C14"



        Foreground="#F1F5F9"



        FontFamily="Segoe UI"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>







    <Window.DataContext>



        <vm:MainViewModel />



    </Window.DataContext>







    <Window.Resources>
        <!-- ========================================================= -->
        <!-- TITLE BAR CONTROL BUTTON STYLES                           -->
        <!-- ========================================================= -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E11D48" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BE123C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- CYBER COMBOBOX STYLES (ORGANIZATION & SITE DROPDOWNS)     -->
        <!-- ========================================================= -->
        <ControlTemplate x:Key="CyberComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <!-- Modern Dropdown Arrow -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="Arrow"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="#38BDF8"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#00E5FF" />
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#17233B" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#00E5FF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#00E5FF" />
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#111B2E" />
                    <Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 4 0 L 8 4" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#00E5FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CyberComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2E4A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0C345B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00E5FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberFilterComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#1E2E4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,24,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CyberComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource CyberComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#0B132B"
                                        BorderBrush="#0284C7"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,3,0,0"
                                        Padding="3">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.8" />
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="48" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#00E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />







        <!-- Map Station Pin Button (Optimized for High-Contrast Dark & White Maps) -->



        <Style x:Key="MapStationPinButton" TargetType="Button">



            <Setter Property="Background" Value="#0F172A" />



            <Setter Property="Foreground" Value="#00E5FF" />



            <Setter Property="BorderBrush" Value="#0284C7" />



            <Setter Property="BorderThickness" Value="1.2" />



            <Setter Property="Padding" Value="5,2" />



            <Setter Property="FontSize" Value="10" />



            <Setter Property="FontWeight" Value="SemiBold" />



            <Setter Property="Cursor" Value="Hand" />



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border Background="{TemplateBinding Background}"



                                BorderBrush="{TemplateBinding BorderBrush}"



                                BorderThickness="{TemplateBinding BorderThickness}"



                                CornerRadius="5"



                                Padding="{TemplateBinding Padding}">



                            <Border.Effect>



                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5" />



                            </Border.Effect>



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />



                        </Border>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



            <Style.Triggers>



                <Trigger Property="IsMouseOver" Value="True">



                    <Setter Property="Background" Value="#1E293B" />



                    <Setter Property="BorderBrush" Value="#00E5FF" />



                </Trigger>



            </Style.Triggers>



        </Style>







        <!-- Sleek Dark Card Style -->



        <Style x:Key="AgnixCard" TargetType="Border">



            <Setter Property="Background" Value="#0F1420" />



            <Setter Property="BorderBrush" Value="#1A2234" />



            <Setter Property="BorderThickness" Value="1" />



            <Setter Property="CornerRadius" Value="10" />



            <Setter Property="Padding" Value="14" />



        </Style>







        <!-- Base Cyber Tech Button -->



        <Style x:Key="CyberButton" TargetType="Button">



            <Setter Property="Background" Value="#1A2338" />



            <Setter Property="Foreground" Value="#F8FAFC" />



            <Setter Property="FontSize" Value="12" />



            <Setter Property="FontWeight" Value="SemiBold" />



            <Setter Property="Padding" Value="12,6" />



            <Setter Property="BorderThickness" Value="0" />



            <Setter Property="Cursor" Value="Hand" />



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border Background="{TemplateBinding Background}" 



                                CornerRadius="6" 



                                Padding="{TemplateBinding Padding}">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />



                        </Border>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



            <Style.Triggers>



                <Trigger Property="IsMouseOver" Value="True">



                    <Setter Property="Background" Value="#2A3856" />



                </Trigger>



            </Style.Triggers>



        </Style>







        <!-- Accent Cyan Button -->



        <Style x:Key="CyanButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">



            <Setter Property="Background" Value="#0284C7" />



            <Style.Triggers>



                <Trigger Property="IsMouseOver" Value="True">



                    <Setter Property="Background" Value="#00E5FF" />



                    <Setter Property="Foreground" Value="#080C14" />



                </Trigger>



            </Style.Triggers>



        </Style>







        <!-- Emergency Red Button -->



        <Style x:Key="EmergencyRedButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">



            <Setter Property="Background" Value="#DC2626" />



            <Setter Property="FontSize" Value="13" />



            <Setter Property="FontWeight" Value="Bold" />



            <Style.Triggers>



                <Trigger Property="IsMouseOver" Value="True">



                    <Setter Property="Background" Value="#EF4444" />



                </Trigger>



            </Style.Triggers>



        </Style>







        <!-- Dark TextBox -->



        <Style x:Key="CyberTextBox" TargetType="TextBox">



            <Setter Property="Background" Value="#090D16" />



            <Setter Property="Foreground" Value="#F8FAFC" />



            <Setter Property="BorderBrush" Value="#243048" />



            <Setter Property="BorderThickness" Value="1" />



            <Setter Property="Padding" Value="8,5" />



            <Setter Property="FontSize" Value="12" />



        </Style>







        <!-- Sidebar Navigation Button -->



        <Style x:Key="NavButton" TargetType="Button">



            <Setter Property="Background" Value="Transparent" />



            <Setter Property="Foreground" Value="#7E8DA6" />



            <Setter Property="FontSize" Value="13" />



            <Setter Property="FontWeight" Value="Medium" />



            <Setter Property="Padding" Value="14,10" />



            <Setter Property="HorizontalContentAlignment" Value="Left" />



            <Setter Property="BorderThickness" Value="0" />



            <Setter Property="Cursor" Value="Hand" />



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">



                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="BtnBorder" Property="Background" Value="#121828" />



                                <Setter Property="Foreground" Value="#E2E8F0" />



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>



    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Dark Cyber Title Bar (WindowChrome) -->
            <RowDefinition Height="38" />
            <!-- Row 1: Main Application Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- ROW 0: TOP CUSTOM CYBER TITLE BAR (WINDOW CHROME)         -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#060A12" BorderBrush="#141D2E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand Logo, Title & Status -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Draggable Center Space -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Controls (Minimize, Maximize, Close) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Official Logo + Title + Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="5" Background="#0E1626" BorderBrush="#0284C7" BorderThickness="1" Margin="0,0,8,0" Padding="1" ClipToBounds="True">
                        <Image Source="Resources/LEHOANG.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="LÊ HOÀNG ROBOTICS" FontSize="11.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="•" FontSize="12" Foreground="#334155" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="CONTROL CENTER" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    
                    <Border Background="#091322" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding ConnectionStatusColor}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding ConnectionStatusColor}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Draggable Spacer -->
                <Grid Grid.Column="1" Background="Transparent" />

                <!-- Right: Window Caption Controls (Min, Max, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn"
                            Click="MinimizeBtn_Click"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Thu nhỏ cửa sổ">
                        <TextBlock Text="—" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="MaximizeBtn"
                            Click="MaximizeBtn_Click"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Phóng to toàn màn hình">
                        <TextBlock x:Name="MaximizeBtnIcon" Text="❐" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="CloseBtn"
                            Click="CloseBtn_Click"
                            Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="Đóng ứng dụng">
                        <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 1: MAIN APPLICATION BODY                              -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>



            <!-- 0: Left Sidebar (Logo & Nav) -->



            <ColumnDefinition Width="200" />



            <!-- 1: Main Content Center (Map, KPI, Charts, Inventory) -->



            <ColumnDefinition Width="*" />



            <!-- 2: Right Column (Robot Cards, Recent Alerts, Teleop & Diagnostic) -->



            <ColumnDefinition Width="Auto" />



        </Grid.ColumnDefinitions>







        <!-- ========================================================= -->



        <!-- COLUMN 0: LEFT SIDEBAR WITH LE HOANG ROBOTICS LOGO       -->



        <!-- ========================================================= -->



        <Border Grid.Column="0" Background="#0A0E18" BorderBrush="#141C2C" BorderThickness="0,0,1,0" Padding="12,10">



            <Grid>



                <Grid.RowDefinitions>



                    <!-- Brand Logo -->



                    <RowDefinition Height="Auto" />



                    <!-- Nav Menu -->



                    <RowDefinition Height="*" />



                    <!-- Bottom System Info -->



                    <RowDefinition Height="Auto" />



                </Grid.RowDefinitions>







                <!-- Brand Logo: LE HOANG ROBOTICS Official Logo -->
                <StackPanel Grid.Row="0" Margin="4,0,0,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="8" Background="#111726" BorderBrush="#0284C7" BorderThickness="1.2" Margin="0,0,10,0" Padding="2" ClipToBounds="True">
                            <Image Source="Resources/LEHOANG.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LE HOANG" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" />
                            <TextBlock Text="ROBOTICS" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>







                <!-- Sidebar Nav Menu Items -->



                <StackPanel Grid.Row="1">



                    <!-- DASHBOARD -->



                    <Border Background="{Binding DashboardNavBg}" CornerRadius="6" Margin="0,0,0,4">



                        <Button Style="{StaticResource NavButton}" Foreground="{Binding DashboardNavFg}" FontWeight="Bold" Command="{Binding ShowDashboardCommand}">



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="⊞" FontSize="15" Margin="0,0,10,0" Foreground="{Binding DashboardNavFg}" VerticalAlignment="Center" />



                                <TextBlock Text="DASHBOARD" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />



                            </StackPanel>



                        </Button>



                    </Border>







                    <!-- ROBOT FLEET MANAGEMENT (QUẢN LÝ & THÊM ROBOTS - ĐỒNG BỘ CLOUD) -->

                    <Border Background="{Binding EnterpriseNavBg}" CornerRadius="6" Margin="0,0,0,4">

                        <Button Style="{StaticResource NavButton}" Foreground="{Binding EnterpriseNavFg}" FontWeight="SemiBold" Command="{Binding ShowEnterpriseCommand}" ToolTip="Quản lý &amp; Thêm Robots theo Chi nhánh (Đồng bộ thời gian thực với Cloud Server)">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🤖" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <TextBlock Text="Thêm Robots" FontSize="12" VerticalAlignment="Center" Foreground="{Binding EnterpriseNavFg}" FontWeight="SemiBold" />

                            </StackPanel>

                        </Button>

                    </Border>







                    <!-- TASKS -->



                    <Border Background="{Binding TasksNavBg}" CornerRadius="6" Margin="0,0,0,4">



                        <Button Style="{StaticResource NavButton}" Foreground="{Binding TasksNavFg}" FontWeight="SemiBold" Command="{Binding ShowTasksCommand}" ToolTip="Quản lý &amp; điều phối nhiệm vụ giao thức ăn cho 3 khay robot">



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="🍱" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />



                                <TextBlock Text="Tasks" FontSize="13" VerticalAlignment="Center" Foreground="{Binding TasksNavFg}" FontWeight="SemiBold" />



                            </StackPanel>



                        </Button>



                    </Border>







                    <!-- MAPS -->



                    <Border Background="{Binding MapsNavBg}" CornerRadius="6" Margin="0,0,0,4">



                        <Button Style="{StaticResource NavButton}" Foreground="{Binding MapsNavFg}" FontWeight="SemiBold" Command="{Binding ShowMapsCommand}" ToolTip="Xem, chọn bản đồ và điều hướng robot">



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="🗺️" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />



                                <TextBlock Text="Maps" FontSize="13" VerticalAlignment="Center" Foreground="{Binding MapsNavFg}" FontWeight="SemiBold" />



                            </StackPanel>



                        </Button>



                    </Border>







                    <!-- ORDERS -->



                    <Border Background="{Binding OrdersNavBg}" CornerRadius="6" Margin="0,0,0,4">



                        <Button Style="{StaticResource NavButton}" Foreground="{Binding OrdersNavFg}" FontWeight="SemiBold" Command="{Binding ShowOrdersCommand}" ToolTip="Lịch sử nhiệm vụ và dịch vụ giao hàng đã thực hiện">



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="📋" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />



                                <TextBlock Text="Đơn hàng" FontSize="12" VerticalAlignment="Center" Foreground="{Binding OrdersNavFg}" FontWeight="SemiBold" />



                            </StackPanel>



                        </Button>



                    </Border>







                    <!-- ALERTS -->



                    <Border Background="{Binding AlertsNavBg}" CornerRadius="6" Margin="0,0,0,4">



                        <Button Style="{StaticResource NavButton}" Foreground="{Binding AlertsNavFg}" FontWeight="SemiBold" Command="{Binding ShowAlertsCommand}" ToolTip="Nhật ký các thông báo, cảnh báo mất định vị, pin yếu, vật cản">



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="🔔" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />



                                <TextBlock Text="Cảnh báo" FontSize="12" VerticalAlignment="Center" Foreground="{Binding AlertsNavFg}" FontWeight="SemiBold" />



                            </StackPanel>



                        </Button>



                    </Border>



                </StackPanel>







                <!-- Bottom Simulation / Diagnostic Badge -->



                <Border Grid.Row="2" Background="#111724" CornerRadius="8" Padding="10,8" BorderBrush="#1C263A" BorderThickness="1">



                    <StackPanel>



                        <TextBlock Text="CHẾ ĐỘ HOẠT ĐỘNG" FontSize="9" FontWeight="Bold" Foreground="#64748B" />



                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">



                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">



                                <Ellipse.Style>



                                    <Style TargetType="Ellipse">



                                        <Setter Property="Fill" Value="#EF4444" />



                                        <Style.Triggers>



                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">



                                                <Setter Property="Fill" Value="#10B981" />



                                            </DataTrigger>



                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">



                                                <Setter Property="Fill" Value="#00E5FF" />



                                            </DataTrigger>



                                        </Style.Triggers>



                                    </Style>



                                </Ellipse.Style>



                            </Ellipse>



                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#64748B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCloudConnected}" Value="True">
                                                <Setter Property="Fill" Value="#06B6D4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CloudStatusText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>

                    </StackPanel>



                </Border>



            </Grid>



        </Border>







        <!-- ========================================================= -->



        <!-- COLUMN 1: MAIN DASHBOARD CENTER (MAP, STATS, CHARTS)      -->



        <!-- ========================================================= -->



        <Grid Grid.Column="1" Margin="14,10,12,10">

            <!-- VIEW 1: MAIN DASHBOARD -->

            <Grid Visibility="{Binding DashboardVisibility}">

                <Grid.RowDefinitions>
                    <!-- 0: Top Header / Breadcrumb -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: 4 KPI Cards (Fleet Status, Online, Orders, Utilization) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Fleet Overview Blueprint Map -->
                    <RowDefinition Height="*" MinHeight="250" />               
                    <!-- 3: Robot Inventory Carousel -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- ROW 0: TOP HEADER BAR -->



            <Grid Grid.Row="0" Margin="0,0,0,14">



                <Grid.ColumnDefinitions>



                    <ColumnDefinition Width="Auto" />



                    <ColumnDefinition Width="*" />



                    <ColumnDefinition Width="Auto" />



                </Grid.ColumnDefinitions>







                <!-- Capsule Header Title -->
                <Border Grid.Column="0" Background="#0C1527" CornerRadius="8" Padding="12,5" BorderBrush="#0284C7" BorderThickness="1.2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="DASHBOARD" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Scope Selectors: Organization & Site Dropdowns -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Tổ chức (Organization) Filter Capsule -->
                    <Border Background="#0C1424" BorderBrush="#1E2E4A" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="TỔ CHỨC:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding OrganizationFilterOptions}"
                                      SelectedItem="{Binding SelectedOrgFilter}"
                                      Style="{StaticResource CyberFilterComboBox}"
                                      Width="180" Height="28"
                                      ToolTip="Lọc dữ liệu theo Tổ chức doanh nghiệp" />
                        </StackPanel>
                    </Border>

                    <!-- Site / Chi nhánh Filter Capsule -->
                    <Border Background="#0C1424" BorderBrush="#1E2E4A" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📍" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="SITE / CHI NHÁNH:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding SiteFilterOptions}"
                                      SelectedItem="{Binding SelectedSiteFilter}"
                                      Style="{StaticResource CyberFilterComboBox}"
                                      Width="170" Height="28"
                                      ToolTip="Lọc danh sách Robot theo Site / Chi nhánh" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Control Icons -->



                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">



                   

                    <!-- Quick Diagnostic Check Button -->



                    <Button Command="{Binding ToggleRightPanelCommand}" Content="📑 Bảng phụ" Style="{StaticResource CyberButton}" Margin="0,0,8,0" FontSize="11" Padding="8,5" ToolTip="Ẩn / Hiện thanh điều khiển phụ bên phải" />


                    <!-- User Avatar & Profile Dropdown Button -->
                    <Grid>
                        <Button x:Name="UserAvatarBtn"
                                Command="{Binding ToggleProfileMenuCommand}"
                                Cursor="Hand"
                                ToolTip="Hồ sơ tài khoản &amp; Đăng xuất (Bấm để mở menu)"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="32" Height="32"
                                            Background="#0284C7"
                                            CornerRadius="16"
                                            BorderBrush="#38BDF8"
                                            BorderThickness="1.5">
                                        <TextBlock Text="{Binding UserAvatarInitials}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFFFFF" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Profile Dropdown Popup -->
                        <Popup x:Name="ProfilePopup"
                               IsOpen="{Binding IsProfileMenuOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=UserAvatarBtn}"
                               Placement="Bottom"
                               HorizontalOffset="-210"
                               VerticalOffset="8"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Width="270"
                                    Background="#0B132B"
                                    BorderBrush="#00E5FF"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.85" />
                                </Border.Effect>
                                <StackPanel>
                                    <!-- User Header Info -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#0284C7" CornerRadius="20" BorderBrush="#00E5FF" BorderThickness="1.5" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding UserAvatarInitials}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='Lê Hoàng'}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentUser.Username, StringFormat='@{0}', FallbackValue='@admin'}" FontSize="11" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Role & Scope Badges -->
                                    <Border Background="#141C2C" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Vai trò: " FontSize="11" Foreground="#94A3B8" />
                                                <Border Background="#0369A1" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{Binding CurrentUser.Role, FallbackValue='SuperAdmin'}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="Tổ chức: " FontSize="10" Foreground="#64748B" />
                                                <TextBlock Text="{Binding CurrentUser.OrganizationName, FallbackValue='Lê Hoàng Robotics Corp'}" FontSize="10" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Site: " FontSize="10" Foreground="#64748B" />
                                                <TextBlock Text="{Binding CurrentUser.SiteName, FallbackValue='Toàn hệ thống'}" FontSize="10" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Rectangle Height="1" Fill="#1E293B" Margin="0,2,0,10" />

                                    <!-- Action 1: Đổi mật khẩu -->
                                    <Button Command="{Binding OpenChangePasswordDialogCommand}"
                                            Style="{StaticResource CyberButton}"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            Height="32"
                                            Margin="0,0,0,8"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔑" Margin="0,0,8,0" FontSize="12" />
                                            <TextBlock Text="Đổi mật khẩu" FontWeight="SemiBold" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Action 2: Đăng xuất -->
                                    <Button Command="{Binding LogoutCommand}"
                                            Style="{StaticResource CyberButton}"
                                            Background="#450A0A"
                                            BorderBrush="#EF4444"
                                            Foreground="#FCA5A5"
                                            Height="32"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚪" Margin="0,0,8,0" FontSize="12" />
                                            <TextBlock Text="Đăng xuất khỏi hệ thống" FontWeight="SemiBold" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>



                </StackPanel>



            </Grid>







            <!-- ROW 1: 4 KPI METRIC CARDS -->



            <Grid Grid.Row="1" Margin="0,0,0,14">



                <Grid.ColumnDefinitions>



                    <ColumnDefinition Width="*" />



                    <ColumnDefinition Width="*" />



                    <ColumnDefinition Width="*" />



                    <ColumnDefinition Width="*" />



                </Grid.ColumnDefinitions>







                <!-- Card 1: Fleet Status -->



                <Border Grid.Column="0" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">



                    <Grid>



                        <StackPanel>



                            <Grid>



                                <TextBlock Text="Fleet Status" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />



                                <TextBlock Text="Online" HorizontalAlignment="Right" FontSize="10" Foreground="#10B981" FontWeight="Bold" />



                            </Grid>



                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">



                                <TextBlock Text="{Binding AvailableFleetCount}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF" />



                                <TextBlock Text=" OBY" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" Margin="4,0,0,4" />



                            </StackPanel>



                            <!-- Mini Wave Sparkline -->



                            <Path Stroke="#00E5FF" StrokeThickness="1.5" Fill="Transparent" Data="M 0,16 Q 15,2 30,12 T 60,6 T 90,14 T 120,4 T 150,10 T 180,8" Margin="0,2,0,0" Height="18" />



                        </StackPanel>



                    </Grid>



                </Border>







                <!-- Card 2: Online Robots -->



                <Border Grid.Column="1" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">



                    <Grid>



                        <StackPanel>



                            <Grid>



                                <TextBlock Text="Online Robots" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />



                                <TextBlock Text="⚡" HorizontalAlignment="Right" FontSize="10" Foreground="#10B981" />



                            </Grid>



                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">



                                <TextBlock Text="{Binding OnlineRobotsPercentage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />



                                <TextBlock Text="%" FontSize="14" Foreground="#7E8DA6" VerticalAlignment="Bottom" Margin="2,0,0,4" />



                            </StackPanel>



                            <!-- Mini Curve -->



                            <Path Stroke="#10B981" StrokeThickness="1.5" Fill="Transparent" Data="M 0,14 Q 25,12 50,8 T 100,10 T 140,4 T 180,2" Margin="0,2,0,0" Height="18" />



                        </StackPanel>



                    </Grid>



                </Border>







                <!-- Card 3: Orders in Progress -->



                <Border Grid.Column="2" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">



                    <Grid>



                        <StackPanel>



                            <Grid>



                                <TextBlock Text="Orders in Progress" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />



                                <TextBlock Text="Host" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B" />



                            </Grid>



                            <TextBlock Text="{Binding OrdersInProgressCount}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,2" />



                            <!-- Mini Wave -->



                            <Path Stroke="#38BDF8" StrokeThickness="1.5" Fill="Transparent" Data="M 0,10 Q 30,16 60,8 T 120,12 T 180,6" Margin="0,2,0,0" Height="18" />



                        </StackPanel>



                    </Grid>



                </Border>







                <!-- Card 4: Avg. Utilization -->



                <Border Grid.Column="3" Style="{StaticResource AgnixCard}">



                    <Grid>



                        <StackPanel>



                            <Grid>



                                <TextBlock Text="Avg. Utilization" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />



                                <TextBlock Text="OPTeo" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B" />



                            </Grid>



                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">



                                <TextBlock Text="{Binding AvgUtilizationPercentage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />



                                <TextBlock Text="%" FontSize="14" Foreground="#7E8DA6" VerticalAlignment="Bottom" Margin="2,0,0,4" />



                            </StackPanel>



                            <!-- Mini Trend -->



                            <Path Stroke="#818CF8" StrokeThickness="1.5" Fill="Transparent" Data="M 0,12 Q 35,4 70,14 T 140,8 T 180,3" Margin="0,2,0,0" Height="18" />



                        </StackPanel>



                    </Grid>



                </Border>



            </Grid>







            <!-- ROW 2: FLEET OVERVIEW BLUEPRINT MAP (THE CENTERPIECE) -->



            <Border Grid.Row="2" Style="{StaticResource AgnixCard}" Margin="0,0,0,12" Padding="0">



                <Grid ClipToBounds="True">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                    </Grid.RowDefinitions>







                    <!-- Header & Status Legend -->



                    <Border Grid.Row="0" Background="#0C111C" Padding="14,10" BorderBrush="#162032" BorderThickness="0,0,0,1">



                        <Grid>



                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                                <TextBlock Text="Bản đồ" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />







                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">



                                    <TextBlock Text="{Binding CurrentMap, StringFormat='🗺️ {0}'}" FontSize="10" Foreground="#00E5FF" FontWeight="SemiBold" />



                                </Border>



                                <Button Command="{Binding ShowMapsCommand}" Style="{StaticResource CyberButton}" Margin="8,0,0,0" Padding="8,3" FontSize="10" Content="Mở Studio Map ➔" ToolTip="Mở giao diện quản lý bản đồ chuyên sâu" />



                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">



                                    <TextBlock Text="{Binding PoseX, StringFormat='X: {0:F2}m'}" FontSize="10" Foreground="#10B981" />



                                </Border>



                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">



                                    <TextBlock Text="{Binding PoseY, StringFormat='Y: {0:F2}m'}" FontSize="10" Foreground="#10B981" />



                                </Border>



                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">



                                    <TextBlock Text="{Binding BatteryLevel, StringFormat='Pin: {0}%'}" FontSize="10" Foreground="#F59E0B" FontWeight="Bold" />



                                </Border>







                                <!-- Localization Status Badge -->



                                <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0">



                                    <Border.Style>



                                        <Style TargetType="Border">



                                            <Setter Property="Background" Value="#064E3B" />



                                            <Style.Triggers>



                                                <DataTrigger Binding="{Binding IsEstimated}" Value="False">



                                                    <Setter Property="Background" Value="#7F1D1D" />



                                                </DataTrigger>



                                            </Style.Triggers>



                                        </Style>



                                    </Border.Style>



                                    <TextBlock Text="{Binding LocalizationStatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />



                                </Border>







                                <!-- Quick Relocalize Tools Right on Dashboard -->



                                <Button Command="{Binding ToggleRelocalizeModeCommand}" Content="{Binding RelocalizeModeText}"



                                        Style="{StaticResource CyberButton}" Background="#DC2626" FontSize="10" Padding="6,3" Margin="6,0,0,0"



                                        ToolTip="Bấm vào đây rồi click chuột lên bản đồ tại chỗ robot đang đứng để định vị lại robot ngay lập tức!" />







                                <Button Command="{Binding ResetEstimateCommand}" Content="🔍 Tự dò vị trí"



                                        Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="10" Padding="6,3" Margin="4,0,0,0"



                                        ToolTip="Robot tự động quét Lidar để tìm lại vị trí trên toàn bộ bản đồ" />







                                <Button Command="{Binding CenterOnRobotCommand}" Content="🎯 Căn giữa"



                                        Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="10" Padding="6,3" Margin="4,0,0,0"



                                        ToolTip="Căn giữa màn hình bản đồ vào vị trí robot" />



                            </StackPanel>







                            <!-- Status Legend -->



                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">



                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" />



                                <TextBlock Text="Online" FontSize="11" Foreground="#94A3B8" Margin="0,0,14,0" />







                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" />



                                <TextBlock Text="Active" FontSize="11" Foreground="#94A3B8" Margin="0,0,14,0" />







                                <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" />



                                <TextBlock Text="Charging" FontSize="11" Foreground="#94A3B8" />



                            </StackPanel>



                        </Grid>



                    </Border>







                    <!-- Interactive Zoom & Pan Map Viewport -->



                    <Border Grid.Row="1" Background="{Binding MapViewportBackground}" ClipToBounds="True" x:Name="MapViewport"



                            PreviewMouseWheel="MapViewport_PreviewMouseWheel"



                            MouseDown="MapViewport_MouseDown"



                            MouseMove="MapViewport_MouseMove"



                            MouseUp="MapViewport_MouseUp"



                            Cursor="SizeAll">



                        <Grid>



                            <!-- Transformable Map Layer (Zoom & Pan applied to this Canvas) -->



                            <Canvas x:Name="MapTransformCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"



                                    Width="{Binding MapDisplayWidth}" Height="{Binding MapDisplayHeight}">



                                <Canvas.RenderTransform>



                                    <TransformGroup>



                                        <ScaleTransform x:Name="MapScaleTransform" ScaleX="{Binding MapZoom}" ScaleY="{Binding MapZoom}" CenterX="150" CenterY="220" />



                                        <TranslateTransform x:Name="MapTranslateTransform" X="{Binding MapPanX}" Y="{Binding MapPanY}" />



                                    </TransformGroup>



                                </Canvas.RenderTransform>







                                <!-- REAL ROBOT MAP IMAGE (Loaded live from Robot via Base64 - Rendered in Clean CAD High-Contrast) -->



                                <Border Width="{Binding MapDisplayWidth}" Height="{Binding MapDisplayHeight}" CornerRadius="6" ClipToBounds="True" Background="#080C14" BorderBrush="#1C273C" BorderThickness="1">



                                    <Image Source="{Binding CurrentMapImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="1.0" />



                                </Border>







                                <!-- Mock Blueprint Blocks & Routes (Only visible when no real map is loaded) -->



                                <Canvas Visibility="{Binding MockMapVisibility}">



                                    <Rectangle Canvas.Left="40" Canvas.Top="30" Width="140" Height="180" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />



                                    <Rectangle Canvas.Left="210" Canvas.Top="30" Width="200" Height="180" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />



                                    <Rectangle Canvas.Left="440" Canvas.Top="30" Width="180" Height="90" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />



                                    <Rectangle Canvas.Left="440" Canvas.Top="140" Width="180" Height="70" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />







                                    <!-- GLOWING CYAN NAVIGATION ROUTES (Mockup) -->



                                    <Path Stroke="#00E5FF" StrokeThickness="4" Opacity="0.3">



                                        <Path.Data>



                                            <PathGeometry>



                                                <PathFigure StartPoint="150,160">



                                                    <LineSegment Point="180,70" />



                                                    <LineSegment Point="430,70" />



                                                    <LineSegment Point="470,80" />



                                                    <LineSegment Point="470,170" />



                                                    <LineSegment Point="360,170" />



                                                    <LineSegment Point="360,210" />



                                                    <LineSegment Point="260,210" />



                                                    <LineSegment Point="150,160" />



                                                </PathFigure>



                                            </PathGeometry>



                                        </Path.Data>



                                    </Path>







                                    <Path Stroke="#00E5FF" StrokeThickness="2">



                                        <Path.Data>



                                            <PathGeometry>



                                                <PathFigure StartPoint="150,160">



                                                    <LineSegment Point="180,70" />



                                                    <LineSegment Point="430,70" />



                                                    <LineSegment Point="470,80" />



                                                    <LineSegment Point="470,170" />



                                                    <LineSegment Point="360,170" />



                                                    <LineSegment Point="360,210" />



                                                    <LineSegment Point="260,210" />



                                                    <LineSegment Point="150,160" />



                                                </PathFigure>



                                            </PathGeometry>



                                        </Path.Data>



                                    </Path>



                                </Canvas>







                                <!-- Dynamic Station Markers plotted at their real coordinates on the map -->



                                <ItemsControl ItemsSource="{Binding MapStations}">



                                    <ItemsControl.ItemsPanel>



                                        <ItemsPanelTemplate>



                                            <Canvas Width="{Binding DataContext.MapDisplayWidth, RelativeSource={RelativeSource AncestorType=Window}}" 



                                                    Height="{Binding DataContext.MapDisplayHeight, RelativeSource={RelativeSource AncestorType=Window}}" />



                                        </ItemsPanelTemplate>



                                    </ItemsControl.ItemsPanel>



                                    <ItemsControl.ItemContainerStyle>



                                        <Style TargetType="ContentPresenter">



                                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />



                                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />



                                            <Setter Property="Panel.ZIndex" Value="5" />



                                        </Style>



                                    </ItemsControl.ItemContainerStyle>



                                    <ItemsControl.ItemTemplate>



                                        <DataTemplate>



                                            <Canvas>



                                                <!-- Physical Pin Beacon Dot -->



                                                <Ellipse Canvas.Left="-4" Canvas.Top="-4" Width="8" Height="8" Fill="{Binding BadgeColor}" Stroke="#0A111E" StrokeThickness="1.5">



                                                    <Ellipse.Effect>



                                                        <DropShadowEffect Color="{Binding BadgeColor}" BlurRadius="4" ShadowDepth="0" Opacity="0.85" />



                                                    </Ellipse.Effect>



                                                </Ellipse>







                                                <!-- Station Label: Clean Text Only (No Frame, No Background Box!) -->



                                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 



                                                        CommandParameter="{Binding}" 



                                                        Canvas.Left="6" Canvas.Top="-10"



                                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"



                                                        ToolTip="{Binding Name, StringFormat='Điểm: {0}&#x0a;Bấm để robot tự động di chuyển đến đây'}">



                                                    <Button.Template>



                                                        <ControlTemplate TargetType="Button">



                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                                                                <TextBlock Text="{Binding Icon}" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center" />



                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" 



                                                                           Foreground="{Binding DataContext.StationTextForeground, RelativeSource={RelativeSource AncestorType=Window}}"



                                                                           VerticalAlignment="Center">



                                                                    <TextBlock.Effect>



                                                                        <DropShadowEffect Color="{Binding DataContext.StationTextHaloColor, RelativeSource={RelativeSource AncestorType=Window}}" 



                                                                                          BlurRadius="3" ShadowDepth="0" Opacity="0.95" />



                                                                    </TextBlock.Effect>



                                                                </TextBlock>



                                                            </StackPanel>



