<Window x:Class="LeHoangControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LeHoangControlCenter.ViewModels"
        xmlns:models="clr-namespace:LeHoangControlCenter.Models"
        mc:Ignorable="d"
        Title="LE HOANG ROBOTICS – FLEET CONTROL CENTER" 
        Height="960" Width="1480"
        MinHeight="850" MinWidth="1260"
        WindowStartupLocation="CenterScreen"
        Background="#080C14"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Map Station Pin Button (Optimized for High-Contrast Dark & White Maps) -->
        <Style x:Key="MapStationPinButton" TargetType="Button">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#00E5FF" />
            <Setter Property="BorderBrush" Value="#0284C7" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="BorderBrush" Value="#00E5FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sleek Dark Card Style -->
        <Style x:Key="AgnixCard" TargetType="Border">
            <Setter Property="Background" Value="#0F1420" />
            <Setter Property="BorderBrush" Value="#1A2234" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- Base Cyber Tech Button -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#1A2338" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3856" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Accent Cyan Button -->
        <Style x:Key="CyanButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#0284C7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E5FF" />
                    <Setter Property="Foreground" Value="#080C14" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Emergency Red Button -->
        <Style x:Key="EmergencyRedButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#090D16" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#243048" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Sidebar Navigation Button -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7E8DA6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#121828" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 0: Left Sidebar (Logo & Nav) -->
            <ColumnDefinition Width="200" />
            <!-- 1: Main Content Center (Map, KPI, Charts, Inventory) -->
            <ColumnDefinition Width="*" />
            <!-- 2: Right Column (Robot Cards, Recent Alerts, Teleop & Diagnostic) -->
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- COLUMN 0: LEFT SIDEBAR WITH LE HOANG ROBOTICS LOGO       -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="#0A0E18" BorderBrush="#141C2C" BorderThickness="0,0,1,0" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Logo -->
                    <RowDefinition Height="Auto" />
                    <!-- Nav Menu -->
                    <RowDefinition Height="*" />
                    <!-- Bottom System Info -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Logo: LE HOANG ROBOTICS (AgniX Styled) -->
                <StackPanel Grid.Row="0" Margin="4,0,0,26">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Stylized Cyber Hexagon Icon -->
                        <Canvas Width="26" Height="26" Margin="0,0,8,0">
                            <Polygon Points="13,1 25,7 25,19 13,25 1,19 1,7" Stroke="#00E5FF" StrokeThickness="2" Fill="#00E5FF" Opacity="0.2" />
                            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="8" Height="8" Fill="#00E5FF" />
                        </Canvas>
                        <TextBlock Text="LE HOANG" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="ROBOTICS FLEET" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="34,-2,0,0" />
                </StackPanel>

                <!-- Sidebar Nav Menu Items -->
                <StackPanel Grid.Row="1">
                    <!-- DASHBOARD -->
                    <Border Background="{Binding DashboardNavBg}" CornerRadius="6" Margin="0,0,0,4">
                        <Button Style="{StaticResource NavButton}" Foreground="{Binding DashboardNavFg}" FontWeight="Bold" Command="{Binding ShowDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="15" Margin="0,0,10,0" Foreground="{Binding DashboardNavFg}" VerticalAlignment="Center" />
                                <TextBlock Text="DASHBOARD" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <Button Style="{StaticResource NavButton}" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Inventory" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Orders" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- TASKS -->
                    <Border Background="{Binding TasksNavBg}" CornerRadius="6" Margin="0,0,0,4">
                        <Button Style="{StaticResource NavButton}" Foreground="{Binding TasksNavFg}" FontWeight="SemiBold" Command="{Binding ShowTasksCommand}" ToolTip="Quản lý &amp; điều phối nhiệm vụ giao thức ăn cho 3 khay robot">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍱" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tasks" FontSize="13" VerticalAlignment="Center" Foreground="{Binding TasksNavFg}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <Button Style="{StaticResource NavButton}" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Robots" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- MAPS -->
                    <Border Background="{Binding MapsNavBg}" CornerRadius="6" Margin="0,0,0,4">
                        <Button Style="{StaticResource NavButton}" Foreground="{Binding MapsNavFg}" FontWeight="SemiBold" Command="{Binding ShowMapsCommand}" ToolTip="Xem, chọn bản đồ và điều hướng robot">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗺️" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Maps" FontSize="13" VerticalAlignment="Center" Foreground="{Binding MapsNavFg}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <Button Style="{StaticResource NavButton}" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Analytics" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Alerts" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Simulation / Diagnostic Badge -->
                <Border Grid.Row="2" Background="#111724" CornerRadius="8" Padding="10,8" BorderBrush="#1C263A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CHẾ ĐỘ HOẠT ĐỘNG" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#10B981" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                                <Setter Property="Fill" Value="#00E5FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- COLUMN 1: MAIN DASHBOARD CENTER (MAP, STATS, CHARTS)      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="16,14,14,14">
            <!-- VIEW 1: MAIN DASHBOARD -->
            <Grid Visibility="{Binding DashboardVisibility}">
                <Grid.RowDefinitions>
                    <!-- 0: Top Header / Breadcrumb -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: 4 KPI Cards (Fleet Status, Online, Orders, Utilization) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Fleet Overview Blueprint Map -->
                    <RowDefinition Height="*" />
                    <!-- 3: Energy & Utilization Trend Charts -->
                    <RowDefinition Height="125" />
                    <!-- 4: Robot Inventory Carousel -->
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

            <!-- ROW 0: TOP HEADER BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Capsule Header Title -->
                <Border Grid.Column="0" Background="#111724" CornerRadius="6" Padding="14,6" BorderBrush="#1C263A" BorderThickness="1">
                    <TextBlock Text="DASHBOARD" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                </Border>

                <!-- Top Right Control Icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Simulation Toggle Button -->
                    <Button Command="{Binding ToggleSimulationCommand}" Content="⚡ Demo Giả lập" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Background="#14213D" Foreground="#00E5FF" FontSize="11" Padding="10,5" />

                    <!-- Quick Diagnostic Check Button -->
                    <Button Command="{Binding RunDiagnosticCommand}" Content="🔍 Chẩn đoán kết nối" Style="{StaticResource CyanButton}" Margin="0,0,10,0" FontSize="11" Padding="10,5" />

                    <Border Width="30" Height="30" Background="#141C2C" CornerRadius="15" Margin="0,0,8,0">
                        <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                    </Border>
                    <Border Width="30" Height="30" Background="#141C2C" CornerRadius="15" Margin="0,0,8,0">
                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#38BDF8" />
                    </Border>
                    <Border Width="30" Height="30" Background="#0284C7" CornerRadius="15">
                        <TextBlock Text="LH" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ROW 1: 4 KPI METRIC CARDS -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Fleet Status -->
                <Border Grid.Column="0" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">
                    <Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Fleet Status" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />
                                <TextBlock Text="Available" HorizontalAlignment="Right" FontSize="10" Foreground="#00E5FF" FontWeight="Bold" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="{Binding AvailableFleetCount}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF" />
                                <TextBlock Text=" OBY" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                            </StackPanel>
                            <!-- Mini Wave Sparkline -->
                            <Path Stroke="#00E5FF" StrokeThickness="1.5" Fill="Transparent" Data="M 0,16 Q 15,2 30,12 T 60,6 T 90,14 T 120,4 T 150,10 T 180,8" Margin="0,2,0,0" Height="18" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Online Robots -->
                <Border Grid.Column="1" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">
                    <Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Online Robots" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />
                                <TextBlock Text="⚡" HorizontalAlignment="Right" FontSize="10" Foreground="#10B981" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="{Binding OnlineRobotsPercentage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="%" FontSize="14" Foreground="#7E8DA6" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                            </StackPanel>
                            <!-- Mini Curve -->
                            <Path Stroke="#10B981" StrokeThickness="1.5" Fill="Transparent" Data="M 0,14 Q 25,12 50,8 T 100,10 T 140,4 T 180,2" Margin="0,2,0,0" Height="18" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Orders in Progress -->
                <Border Grid.Column="2" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">
                    <Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Orders in Progress" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />
                                <TextBlock Text="Host" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B" />
                            </Grid>
                            <TextBlock Text="{Binding OrdersInProgressCount}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,2" />
                            <!-- Mini Wave -->
                            <Path Stroke="#38BDF8" StrokeThickness="1.5" Fill="Transparent" Data="M 0,10 Q 30,16 60,8 T 120,12 T 180,6" Margin="0,2,0,0" Height="18" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Avg. Utilization -->
                <Border Grid.Column="3" Style="{StaticResource AgnixCard}">
                    <Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Avg. Utilization" FontSize="11" FontWeight="Medium" Foreground="#7E8DA6" />
                                <TextBlock Text="OPTeo" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="{Binding AvgUtilizationPercentage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="%" FontSize="14" Foreground="#7E8DA6" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                            </StackPanel>
                            <!-- Mini Trend -->
                            <Path Stroke="#818CF8" StrokeThickness="1.5" Fill="Transparent" Data="M 0,12 Q 35,4 70,14 T 140,8 T 180,3" Margin="0,2,0,0" Height="18" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: FLEET OVERVIEW BLUEPRINT MAP (THE CENTERPIECE) -->
            <Border Grid.Row="2" Style="{StaticResource AgnixCard}" Margin="0,0,0,12" Padding="0">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Status Legend -->
                    <Border Grid.Row="0" Background="#0C111C" Padding="14,10" BorderBrush="#162032" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Fleet Overview" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />

                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding CurrentMap, StringFormat='🗺️ {0}'}" FontSize="10" Foreground="#00E5FF" FontWeight="SemiBold" />
                                </Border>
                                <Button Command="{Binding ShowMapsCommand}" Style="{StaticResource CyberButton}" Margin="8,0,0,0" Padding="8,3" FontSize="10" Content="Mở Studio Map ➔" ToolTip="Mở giao diện quản lý bản đồ chuyên sâu" />
                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding PoseX, StringFormat='X: {0:F2}m'}" FontSize="10" Foreground="#10B981" />
                                </Border>
                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding PoseY, StringFormat='Y: {0:F2}m'}" FontSize="10" Foreground="#10B981" />
                                </Border>
                                <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding BatteryLevel, StringFormat='Pin: {0}%'}" FontSize="10" Foreground="#F59E0B" FontWeight="Bold" />
                                </Border>

                                <!-- Localization Status Badge -->
                                <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#064E3B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEstimated}" Value="False">
                                                    <Setter Property="Background" Value="#7F1D1D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LocalizationStatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>

                                <!-- Quick Relocalize Tools Right on Dashboard -->
                                <Button Command="{Binding ToggleRelocalizeModeCommand}" Content="{Binding RelocalizeModeText}"
                                        Style="{StaticResource CyberButton}" Background="#DC2626" FontSize="10" Padding="6,3" Margin="6,0,0,0"
                                        ToolTip="Bấm vào đây rồi click chuột lên bản đồ tại chỗ robot đang đứng để định vị lại robot ngay lập tức!" />

                                <Button Command="{Binding ResetEstimateCommand}" Content="🔍 Tự dò vị trí"
                                        Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="10" Padding="6,3" Margin="4,0,0,0"
                                        ToolTip="Robot tự động quét Lidar để tìm lại vị trí trên toàn bộ bản đồ" />

                                <Button Command="{Binding CenterOnRobotCommand}" Content="🎯 Căn giữa"
                                        Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="10" Padding="6,3" Margin="4,0,0,0"
                                        ToolTip="Căn giữa màn hình bản đồ vào vị trí robot" />
                            </StackPanel>

                            <!-- Status Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#00E5FF" Margin="0,0,5,0" />
                                <TextBlock Text="Available" FontSize="11" Foreground="#94A3B8" Margin="0,0,14,0" />

                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" />
                                <TextBlock Text="Active" FontSize="11" Foreground="#94A3B8" Margin="0,0,14,0" />

                                <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" />
                                <TextBlock Text="Charging" FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Interactive Zoom & Pan Map Viewport -->
                    <Border Grid.Row="1" Background="{Binding MapViewportBackground}" ClipToBounds="True" x:Name="MapViewport"
                            PreviewMouseWheel="MapViewport_PreviewMouseWheel"
                            MouseDown="MapViewport_MouseDown"
                            MouseMove="MapViewport_MouseMove"
                            MouseUp="MapViewport_MouseUp"
                            Cursor="SizeAll">
                        <Grid>
                            <!-- Transformable Map Layer (Zoom & Pan applied to this Canvas) -->
                            <Canvas x:Name="MapTransformCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="{Binding MapDisplayWidth}" Height="{Binding MapDisplayHeight}">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="MapScaleTransform" ScaleX="{Binding MapZoom}" ScaleY="{Binding MapZoom}" CenterX="150" CenterY="220" />
                                        <TranslateTransform x:Name="MapTranslateTransform" X="{Binding MapPanX}" Y="{Binding MapPanY}" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- REAL ROBOT MAP IMAGE (Loaded live from Robot via Base64 - Rendered in Clean CAD High-Contrast) -->
                                <Border Width="{Binding MapDisplayWidth}" Height="{Binding MapDisplayHeight}" CornerRadius="6" ClipToBounds="True" Background="#080C14" BorderBrush="#1C273C" BorderThickness="1">
                                    <Image Source="{Binding CurrentMapImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="1.0" />
                                </Border>

                                <!-- Mock Blueprint Blocks & Routes (Only visible when no real map is loaded) -->
                                <Canvas Visibility="{Binding MockMapVisibility}">
                                    <Rectangle Canvas.Left="40" Canvas.Top="30" Width="140" Height="180" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />
                                    <Rectangle Canvas.Left="210" Canvas.Top="30" Width="200" Height="180" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />
                                    <Rectangle Canvas.Left="440" Canvas.Top="30" Width="180" Height="90" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />
                                    <Rectangle Canvas.Left="440" Canvas.Top="140" Width="180" Height="70" Fill="#0D1322" Stroke="#141E34" StrokeThickness="1" RadiusX="6" RadiusY="6" />

                                    <!-- GLOWING CYAN NAVIGATION ROUTES (Mockup) -->
                                    <Path Stroke="#00E5FF" StrokeThickness="4" Opacity="0.3">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="150,160">
                                                    <LineSegment Point="180,70" />
                                                    <LineSegment Point="430,70" />
                                                    <LineSegment Point="470,80" />
                                                    <LineSegment Point="470,170" />
                                                    <LineSegment Point="360,170" />
                                                    <LineSegment Point="360,210" />
                                                    <LineSegment Point="260,210" />
                                                    <LineSegment Point="150,160" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>

                                    <Path Stroke="#00E5FF" StrokeThickness="2">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="150,160">
                                                    <LineSegment Point="180,70" />
                                                    <LineSegment Point="430,70" />
                                                    <LineSegment Point="470,80" />
                                                    <LineSegment Point="470,170" />
                                                    <LineSegment Point="360,170" />
                                                    <LineSegment Point="360,210" />
                                                    <LineSegment Point="260,210" />
                                                    <LineSegment Point="150,160" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                </Canvas>

                                <!-- Dynamic Station Markers plotted at their real coordinates on the map -->
                                <ItemsControl ItemsSource="{Binding MapStations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding DataContext.MapDisplayWidth, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    Height="{Binding DataContext.MapDisplayHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                            <Setter Property="Panel.ZIndex" Value="5" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas>
                                                <!-- Physical Pin Beacon Dot -->
                                                <Ellipse Canvas.Left="-4" Canvas.Top="-4" Width="8" Height="8" Fill="{Binding BadgeColor}" Stroke="#0A111E" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{Binding BadgeColor}" BlurRadius="4" ShadowDepth="0" Opacity="0.85" />
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <!-- Station Label: Clean Text Only (No Frame, No Background Box!) -->
                                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        Canvas.Left="6" Canvas.Top="-10"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                        ToolTip="{Binding Name, StringFormat='Điểm: {0}&#x0a;Bấm để robot tự động di chuyển đến đây'}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" 
                                                                           Foreground="{Binding DataContext.StationTextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect Color="{Binding DataContext.StationTextHaloColor, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                          BlurRadius="3" ShadowDepth="0" Opacity="0.95" />
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Dynamic Trajectory Path of current active robot -->
                                <Polyline Points="{Binding TrajectoryPath}" Stroke="#059669" StrokeThickness="2.5" StrokeDashArray="3,2" />

                                <!-- ROBOT 01 MARKER (The moving robot, located directly on the map!) -->
                                <Canvas Canvas.Left="{Binding CanvasRobotLeft}" Canvas.Top="{Binding CanvasRobotTop}" Width="50" Height="50" Margin="-25,-25,0,0" Panel.ZIndex="10">
                                    <!-- Outer Radar Glow Pulse -->
                                    <Ellipse Width="44" Height="44" Canvas.Left="3" Canvas.Top="3" Fill="#00E5FF" Opacity="0.2" />

                                    <!-- Rotating Directional Compass / Chassis (Arrow points forward in travel direction) -->
                                    <Canvas Width="34" Height="34" Canvas.Left="8" Canvas.Top="8" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform Angle="{Binding RobotHeadingDegrees}" />
                                        </Canvas.RenderTransform>
                                        <!-- Sharp Forward Heading Arrow (Points UP at Angle=0) -->
                                        <Polygon Points="17,0 9,12 25,12" Fill="#00E5FF">
                                            <Polygon.Effect>
                                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                            </Polygon.Effect>
                                        </Polygon>
                                        <!-- Circular Robot Chassis Disc -->
                                        <Ellipse Canvas.Left="2" Canvas.Top="4" Width="30" Height="30" Fill="#09101C" Stroke="#00E5FF" StrokeThickness="2" />
                                        <!-- Front Direction Indicator Notch -->
                                        <Polygon Points="17,6 13,12 21,12" Fill="#38BDF8" />
                                    </Canvas>

                                    <!-- Center Robot ID Badge (Always upright, never upside down!) -->
                                    <Border Canvas.Left="17" Canvas.Top="17" Width="16" Height="16" Background="#0F172A" CornerRadius="8" BorderBrush="#38BDF8" BorderThickness="1.2">
                                        <TextBlock Text="01" FontSize="8" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Label Pill -->
                                    <Border Canvas.Left="-5" Canvas.Top="38" Background="#DD0B1220" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="Robot 01" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" />
                                    </Border>
                                </Canvas>
                            </Canvas>

                            <!-- ALERT BANNER: WHEN ROBOT LOSES POSITION -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                                    Background="#B91C1C" BorderBrush="#F87171" BorderThickness="1.5" CornerRadius="6" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEstimated}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠️ MẤT ĐỊNH VỊ!" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Command="{Binding ToggleRelocalizeModeCommand}" Content="{Binding RelocalizeModeText}" Style="{StaticResource CyberButton}" Background="#DC2626" FontSize="10" Padding="6,3" Margin="0,0,6,0" ToolTip="Bấm vào đây rồi click chuột lên bản đồ tại chỗ robot đang đứng để định vị lại" />
                                    <Button Command="{Binding ResetEstimateCommand}" Content="🔄 Quét Laser 360°" Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="10" Padding="6,3" ToolTip="Yêu cầu robot tự động xoay 360 độ và quét Laser đối chiếu bản đồ để tìm lại vị trí" />
                                </StackPanel>
                            </Border>

                            <!-- FLOATING ZOOM & THEME CONTROLS (Top Right of Map) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="#141E30" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding ZoomInCommand}" Content="➕" Width="28" Height="26" Style="{StaticResource CyberButton}" ToolTip="Phóng to (Zoom In)" />
                                    <Border Width="46" Height="26" Background="#0B111E" CornerRadius="3" Margin="3,0">
                                        <TextBlock Text="{Binding MapZoomText}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Button Command="{Binding ZoomOutCommand}" Content="➖" Width="28" Height="26" Style="{StaticResource CyberButton}" ToolTip="Thu nhỏ (Zoom Out)" />
                                    <Button Command="{Binding ResetZoomCommand}" Content="⟲" Width="28" Height="26" Style="{StaticResource CyberButton}" Margin="3,0" ToolTip="Khôi phục kích thước ban đầu (100%)" />
                                    <Button Command="{Binding ToggleMapThemeCommand}" Content="{Binding MapThemeButtonText}" Style="{StaticResource CyberButton}" Padding="8,3" Height="26" FontSize="10" ToolTip="Chuyển đổi giao diện bản đồ Nền sáng CAD / Nền tối Cyber" />
                                </StackPanel>
                            </Border>

                            <!-- Floating Navigation Hint (Bottom Left of Map) -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12" Background="#141E30" Opacity="0.85" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="🖱️ Cuộn chuột: Phóng to/Thu nhỏ | Bấm giữ &amp; kéo chuột: Di chuyển bản đồ" FontSize="10" Foreground="#94A3B8" />
                            </Border>
                        </Grid>
                    </Border>
            </Grid>
        </Border>

            <!-- ROW 3: ENERGY & UTILIZATION TREND CHARTS -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Energy Chart Card -->
                <Border Grid.Column="0" Style="{StaticResource AgnixCard}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Energy" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />

                        <!-- Area / Line Graph -->
                        <Canvas Grid.Row="1" Margin="0,4,0,2">
                            <!-- Background Grid Lines -->
                            <Line X1="0" Y1="15" X2="300" Y2="15" Stroke="#162032" StrokeThickness="1" />
                            <Line X1="0" Y1="35" X2="300" Y2="35" Stroke="#162032" StrokeThickness="1" />
                            <Line X1="0" Y1="55" X2="300" Y2="55" Stroke="#162032" StrokeThickness="1" />
                            <!-- Energy Trend Curve -->
                            <Path Stroke="#00E5FF" StrokeThickness="2" Fill="Transparent" Data="M 0,45 Q 30,55 60,35 T 120,40 T 160,20 T 210,32 T 260,15 T 300,25" />
                        </Canvas>

                        <Grid Grid.Row="2">
                            <TextBlock Text="Last 24h" FontSize="9" Foreground="#64748B" />
                            <TextBlock Text="Realtime Monitoring" HorizontalAlignment="Right" FontSize="9" Foreground="#64748B" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Utilization Chart Card -->
                <Border Grid.Column="1" Style="{StaticResource AgnixCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Utilization" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />

                        <!-- Area / Line Graph -->
                        <Canvas Grid.Row="1" Margin="0,4,0,2">
                            <Line X1="0" Y1="15" X2="300" Y2="15" Stroke="#162032" StrokeThickness="1" />
                            <Line X1="0" Y1="35" X2="300" Y2="35" Stroke="#162032" StrokeThickness="1" />
                            <Line X1="0" Y1="55" X2="300" Y2="55" Stroke="#162032" StrokeThickness="1" />
                            <!-- Utilization Trend Curve -->
                            <Path Stroke="#38BDF8" StrokeThickness="2" Fill="Transparent" Data="M 0,55 Q 40,50 80,35 T 140,42 T 200,22 T 250,18 T 300,10" />
                        </Canvas>

                        <Grid Grid.Row="2">
                            <TextBlock Text="Last 24h" FontSize="9" Foreground="#64748B" />
                            <TextBlock Text="Progress Rate: 87%" HorizontalAlignment="Right" FontSize="9" Foreground="#64748B" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 4: ROBOT INVENTORY CAROUSEL (Identical to bottom row of AgniX) -->
            <Border Grid.Row="4" Style="{StaticResource AgnixCard}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Robot Inventory" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />

                    <!-- Horizontal Grid of 6 Robots -->
                    <UniformGrid Grid.Row="1" Columns="6">
                        <!-- Item 1: ROB01 -->
                        <Border Background="#090E18" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="🏎️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding RobotId}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar Value="{Binding BatteryLevel}" Maximum="100" Height="4" Background="#162034" Foreground="#10B981" BorderThickness="0" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0}% · Online'}" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Item 2: RO-213 -->
                        <Border Background="#090E18" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="🏎️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="RO-213" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar Value="96" Maximum="100" Height="4" Background="#162034" Foreground="#10B981" BorderThickness="0" Margin="0,6,0,2" />
                                <TextBlock Text="96% · Active" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Item 3: ROB04 -->
                        <Border Background="#090E18" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="🏎️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="ROB04" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar Value="45" Maximum="100" Height="4" Background="#162034" Foreground="#F59E0B" BorderThickness="0" Margin="0,6,0,2" />
                                <TextBlock Text="45% · Standby" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Item 4: ROB05 -->
                        <Border Background="#090E18" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="🏎️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="ROB05" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar Value="80" Maximum="100" Height="4" Background="#162034" Foreground="#10B981" BorderThickness="0" Margin="0,6,0,2" />
                                <TextBlock Text="80% · Ready" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Item 5: ROB03 -->
                        <Border Background="#090E18" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="🏎️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="ROB03" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar Value="72" Maximum="100" Height="4" Background="#162034" Foreground="#10B981" BorderThickness="0" Margin="0,6,0,2" />
                                <TextBlock Text="72% · Delivery" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Item 6: ROB08 -->
                        <Border Background="#090E18" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="🏎️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="ROB08" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar Value="91" Maximum="100" Height="4" Background="#162034" Foreground="#10B981" BorderThickness="0" Margin="0,6,0,2" />
                                <TextBlock Text="91% · Ready" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- VIEW 2: DEDICATED MAPS STUDIO & NAVIGATION (FULL VIEW)    -->
            <!-- ========================================================= -->
            <Grid Visibility="{Binding MapsVisibility}">
                <Grid.RowDefinitions>
                    <!-- Top Toolbar for Maps -->
                    <RowDefinition Height="Auto" />
                    <!-- Main Map & Station Navigator -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ROW 0: MAP STUDIO TOP TOOLBAR -->
                <Border Grid.Row="0" Style="{StaticResource AgnixCard}" Margin="0,0,0,12" Padding="12,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ShowDashboardCommand}" Style="{StaticResource CyberButton}" Content="⬅️ Dashboard" Margin="0,0,14,0" Padding="10,5" ToolTip="Quay về bảng điều khiển tổng quan" />
                            <TextBlock Text="🗺️ MAP STUDIO &amp; ĐIỀU HƯỚNG" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />

                            <Border Background="#162238" CornerRadius="4" Padding="8,4" Margin="14,0,8,0">
                                <TextBlock Text="{Binding CurrentMap, StringFormat='Map: {0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </Border>

                            <!-- Map Selection Dropdown -->
                            <Border Background="#111827" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Margin="4,0,6,0">
                                <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding SelectedMap}" Width="150" Height="28" Background="#111827" Foreground="#00E5FF" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" />
                            </Border>
                            <Button Command="{Binding SwitchMapCommand}" Content="⚡ Đổi Map" Style="{StaticResource CyberButton}" Padding="10,4" Margin="0,0,6,0" ToolTip="Áp dụng đổi bản đồ trên robot" />
                            <Button Command="{Binding RefreshMapCommand}" Content="🔄 Tải lại" Style="{StaticResource CyberButton}" Padding="8,4" Margin="0,0,10,0" ToolTip="Tải lại danh sách bản đồ từ robot" />

                            <!-- Localization Status & Relocalize Tools -->
                            <Border CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#064E3B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEstimated}" Value="False">
                                                <Setter Property="Background" Value="#7F1D1D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LocalizationStatusText}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#34D399" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEstimated}" Value="False">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Button Command="{Binding ToggleRelocalizeModeCommand}" Content="📍 Đặt lại vị trí" Style="{StaticResource CyberButton}" Padding="8,4" Margin="0,0,6,0" ToolTip="Bật chế độ: Bấm chuột trên bản đồ để đặt robot tại vị trí đó" />
                            <Button Command="{Binding ResetEstimateCommand}" Content="🔍 Tự dò vị trí" Style="{StaticResource CyberButton}" Padding="8,4" Margin="0,0,10,0" ToolTip="Robot tự quét Lidar tìm lại vị trí trên toàn bản đồ" />
                        </StackPanel>

                        <!-- Right Zoom & View Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding ZoomInCommand}" Content="➕" Width="28" Height="28" Style="{StaticResource CyberButton}" ToolTip="Phóng to" />
                            <Border Width="48" Height="28" Background="#0B111E" CornerRadius="3" Margin="3,0">
                                <TextBlock Text="{Binding MapZoomText}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Command="{Binding ZoomOutCommand}" Content="➖" Width="28" Height="28" Style="{StaticResource CyberButton}" ToolTip="Thu nhỏ" />
                            <Button Command="{Binding ResetZoomCommand}" Content="⟲ 100%" Style="{StaticResource CyberButton}" Margin="3,0" Padding="8,4" ToolTip="Về 100%" />
                            <Button Command="{Binding CenterOnRobotCommand}" Content="🎯 Căn giữa" Style="{StaticResource CyberButton}" Margin="3,0" Padding="8,4" ToolTip="Căn khung nhìn theo vị trí robot" />
                            <Button Command="{Binding ToggleMapThemeCommand}" Content="{Binding MapThemeButtonText}" Style="{StaticResource CyberButton}" Margin="3,0" Padding="8,4" ToolTip="Đổi nền Sáng / Tối" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: MAP WORKSPACE + SIDEBAR STATIONS -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Big Interactive Map Viewport -->
                        <ColumnDefinition Width="*" />
                        <!-- Stations & Coordinate Navigator Panel -->
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <!-- Interactive Map Border -->
                    <Border Grid.Column="0" Background="{Binding MapViewportBackground}" CornerRadius="8" ClipToBounds="True"
                            PreviewMouseWheel="MapViewport_PreviewMouseWheel"
                            MouseDown="MapViewport_MouseDown"
                            MouseMove="MapViewport_MouseMove"
                            MouseUp="MapViewport_MouseUp"
                            Cursor="Cross" Margin="0,0,12,0" BorderBrush="#1C273C" BorderThickness="1">
                        <Grid>
                            <!-- Transform Canvas -->
                            <Canvas x:Name="MapStudioTransformCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="{Binding MapDisplayWidth}" Height="{Binding MapDisplayHeight}">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding MapZoom}" ScaleY="{Binding MapZoom}" CenterX="150" CenterY="220" />
                                        <TranslateTransform X="{Binding MapPanX}" Y="{Binding MapPanY}" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- Real Map Image -->
                                <Border Width="{Binding MapDisplayWidth}" Height="{Binding MapDisplayHeight}" CornerRadius="6" ClipToBounds="True" Background="#080C14" BorderBrush="#1C273C" BorderThickness="1">
                                    <Image Source="{Binding CurrentMapImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="1.0" />
                                </Border>

                                <!-- Dynamic Station Markers -->
                                <ItemsControl ItemsSource="{Binding MapStations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding DataContext.MapDisplayWidth, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    Height="{Binding DataContext.MapDisplayHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                            <Setter Property="Panel.ZIndex" Value="5" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas>
                                                <!-- Physical Pin Beacon Dot -->
                                                <Ellipse Canvas.Left="-4" Canvas.Top="-4" Width="8" Height="8" Fill="{Binding BadgeColor}" Stroke="#0A111E" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{Binding BadgeColor}" BlurRadius="4" ShadowDepth="0" Opacity="0.85" />
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <!-- Station Label: Clean Text Only (No Frame, No Background Box!) -->
                                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        Canvas.Left="6" Canvas.Top="-10"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                        ToolTip="{Binding Name, StringFormat='Điểm: {0}&#x0a;Bấm để robot tự động di chuyển đến đây'}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" 
                                                                           Foreground="{Binding DataContext.StationTextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect Color="{Binding DataContext.StationTextHaloColor, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                          BlurRadius="3" ShadowDepth="0" Opacity="0.95" />
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Trajectory Path -->
                                <Polyline Points="{Binding TrajectoryPath}" Stroke="#059669" StrokeThickness="2.5" StrokeDashArray="3,2" />

                                <!-- Robot Marker -->
                                <Canvas Canvas.Left="{Binding CanvasRobotLeft}" Canvas.Top="{Binding CanvasRobotTop}" Width="50" Height="50" Margin="-25,-25,0,0" Panel.ZIndex="10">
                                    <!-- Outer Radar Glow Pulse -->
                                    <Ellipse Width="44" Height="44" Canvas.Left="3" Canvas.Top="3" Fill="#00E5FF" Opacity="0.2" />

                                    <!-- Rotating Directional Compass / Chassis (Arrow points forward in travel direction) -->
                                    <Canvas Width="34" Height="34" Canvas.Left="8" Canvas.Top="8" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform Angle="{Binding RobotHeadingDegrees}" />
                                        </Canvas.RenderTransform>
                                        <!-- Sharp Forward Heading Arrow (Points UP at Angle=0) -->
                                        <Polygon Points="17,0 9,12 25,12" Fill="#00E5FF">
                                            <Polygon.Effect>
                                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                            </Polygon.Effect>
                                        </Polygon>
                                        <!-- Circular Robot Chassis Disc -->
                                        <Ellipse Canvas.Left="2" Canvas.Top="4" Width="30" Height="30" Fill="#09101C" Stroke="#00E5FF" StrokeThickness="2" />
                                        <!-- Front Direction Indicator Notch -->
                                        <Polygon Points="17,6 13,12 21,12" Fill="#38BDF8" />
                                    </Canvas>

                                    <!-- Center Robot ID Badge (Always upright, never upside down!) -->
                                    <Border Canvas.Left="17" Canvas.Top="17" Width="16" Height="16" Background="#0F172A" CornerRadius="8" BorderBrush="#38BDF8" BorderThickness="1.2">
                                        <TextBlock Text="01" FontSize="8" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Label Pill -->
                                    <Border Canvas.Left="-5" Canvas.Top="38" Background="#DD0B1220" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="Robot 01" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" />
                                    </Border>
                                </Canvas>
                            </Canvas>

                            <!-- Bottom Floating Status & Telemetry Bar -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Background="#DD0B1220" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📍 Vị trí: " FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding PoseX, StringFormat='X={0:F2}m '}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                    <TextBlock Text="{Binding PoseY, StringFormat='Y={0:F2}m '}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                    <TextBlock Text="{Binding PoseTheta, StringFormat='θ={0:F1}°'}" FontSize="11" Foreground="#38BDF8" Margin="0,0,10,0" />
                                    <TextBlock Text="🔋 " FontSize="11" />
                                    <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,10,0" />
                                    <TextBlock Text="🎯 Đích: " FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding TargetDestination}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                                </StackPanel>
                            </Border>

                            <!-- Bottom Floating Action Buttons -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="12">
                                <Button Command="{Binding StopNavigateAsyncCommand}" Content="🛑 DỪNG LẠI" Style="{StaticResource CyberButton}" Background="#DC2626" Padding="10,6" Margin="0,0,6,0" ToolTip="Dừng ngay hành trình di chuyển" />
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Charging Pole" Content="⚡ VỀ TRẠM SẠC" Style="{StaticResource CyberButton}" Background="#D97706" Padding="10,6" Margin="0,0,6,0" ToolTip="Tự hành về đế sạc pin" />
                                <Button Command="{Binding ClearTrajectoryCommand}" Content="🧹 Xóa vệt" Style="{StaticResource CyberButton}" Padding="8,6" ToolTip="Xóa đường vẽ quỹ đạo" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Stations List & Target Coordinates Panel -->
                    <Border Grid.Column="1" Style="{StaticResource AgnixCard}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- STATION MAKER / TẠO ĐIỂM MỚI -->
                                <Border Background="#0C1527" BorderBrush="#00E5FF" BorderThickness="1.2" CornerRadius="8" Margin="0,0,0,12" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="➕ TẠO ĐIỂM MỚI (STATIONS)" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding ToggleStationMakerCommand}" Content="{Binding StationMakerToggleText}"
                                                    Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="9" Padding="6,2" />
                                        </Grid>

                                        <!-- Collapsible Content -->
                                        <StackPanel Visibility="{Binding IsStationMakerExpanded, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Tạo nhanh điểm thang máy cho tầng này:" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,0,6" />

                                            <!-- Elevator Quick Points Grid -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding CreateWaitingElevatorPointCommand}"
                                                        Content="🚪 + Chờ thang máy" Style="{StaticResource CyberButton}" Background="#0284C7"
                                                        FontSize="9.5" Padding="4,6" Margin="0,0,3,0"
                                                        ToolTip="Tạo trạm Chờ thang máy tại vị trí hiện tại của Robot (tự động gán cấu hình tầng)" />
                                                <Button Grid.Column="1" Command="{Binding CreateInsideElevatorPointCommand}"
                                                        Content="🛗 + Trong thang máy" Style="{StaticResource CyberButton}" Background="#059669"
                                                        FontSize="9.5" Padding="4,6" Margin="3,0,0,0"
                                                        ToolTip="Tạo trạm Trong buồng cabin thang máy tại vị trí Robot (tự động gán cấu hình tầng)" />
                                            </Grid>

                                            <!-- Coordinate Capture Tools -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding CaptureRobotPoseForNewPlaceCommand}"
                                                        Content="📍 Lấy vị trí Robot" Style="{StaticResource CyberButton}" Background="#4F46E5"
                                                        FontSize="9.5" Padding="4,5" Margin="0,0,3,0"
                                                        ToolTip="Lấy ngay tọa độ (X, Y) hiện tại của Robot" />
                                                <Button Grid.Column="1" Command="{Binding ToggleAddPointModeCommand}"
                                                        Content="{Binding AddPointModeText}" Style="{StaticResource CyberButton}" Background="#D97706"
                                                        FontSize="9.5" Padding="4,5" Margin="3,0,0,0"
                                                        ToolTip="Bật/Tắt chế độ bấm chuột trực tiếp lên bản đồ để lấy tọa độ tạo điểm" />
                                            </Grid>

                                            <!-- Custom Point Inputs: Name, X, Y & Save -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                    <TextBlock Text="Tên điểm mới:" FontSize="8.5" Foreground="#94A3B8" />
                                                    <TextBox Text="{Binding NewPlaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="24" Background="#060A12" Foreground="#FFFFFF" BorderBrush="#1C273C" FontSize="10" VerticalContentAlignment="Center" Padding="4,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                                    <TextBlock Text="X (m):" FontSize="8.5" Foreground="#94A3B8" />
                                                    <TextBox Text="{Binding NewPlaceX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="24" Background="#060A12" Foreground="#10B981" BorderBrush="#1C273C" FontSize="10" VerticalContentAlignment="Center" Padding="2,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                                    <TextBlock Text="Y (m):" FontSize="8.5" Foreground="#94A3B8" />
                                                    <TextBox Text="{Binding NewPlaceY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="24" Background="#060A12" Foreground="#10B981" BorderBrush="#1C273C" FontSize="10" VerticalContentAlignment="Center" Padding="2,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Button Command="{Binding SaveNewPlaceCommand}" Content="💾 Lưu điểm vào bản đồ"
                                                    Style="{StaticResource CyberButton}" Background="#059669" FontSize="10" FontWeight="Bold" Padding="6,6" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📍 DANH SÁCH ĐIỂM (STATIONS)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8" />
                                <TextBlock Text="Bấm để robot tự động di chuyển đến điểm:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,8" />

                                <ItemsControl ItemsSource="{Binding MapStations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#101827" BorderBrush="#1C263A" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.85">
                                                                <TextBlock Text="{Binding TypeBadge}" FontSize="8" FontWeight="SemiBold" Foreground="#000000" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="16,2,0,0">
                                                            <TextBlock Text="X: " FontSize="9" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding X, StringFormat='{}{0:F2}m'}" FontSize="9" Foreground="#10B981" />
                                                            <TextBlock Text=" | Y: " FontSize="9" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding Y, StringFormat='{}{0:F2}m'}" FontSize="9" Foreground="#10B981" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.SetLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"
                                                                Content="📍 Đặt vị trí" Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="9" Padding="5,4" Margin="0,0,3,0" ToolTip="Đặt vị trí robot tại trạm này (Định vị nhanh)" />
                                                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"
                                                                Content="Đi tới ➔" Style="{StaticResource CyberButton}" FontSize="9.5" Padding="6,4" Margin="0,0,3,0" />
                                                        <Button Command="{Binding DataContext.DeletePlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"
                                                                Content="🗑️" Style="{StaticResource CyberButton}" Background="#7F1D1D" Foreground="#FCA5A5" FontSize="9" Padding="5,4" ToolTip="Xóa điểm này khỏi bản đồ" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Manual Coordinate Navigator -->
                                <Border Background="#101827" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Margin="0,10,0,8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🎯 ĐI TỚI HOẶC ĐẶT TỌA ĐỘ" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Tọa độ X (m):" FontSize="9" Foreground="#94A3B8" />
                                                <TextBox Text="{Binding ManualTargetX, Mode=TwoWay}" Height="24" Background="#0B111E" Foreground="#10B981" BorderBrush="#1C273C" FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Tọa độ Y (m):" FontSize="9" Foreground="#94A3B8" />
                                                <TextBox Text="{Binding ManualTargetY, Mode=TwoWay}" Height="24" Background="#0B111E" Foreground="#10B981" BorderBrush="#1C273C" FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding NavigateToManualCoordCommand}" Content="🚀 Gửi Robot đi" Style="{StaticResource CyberButton}" Padding="6,5" Margin="0,0,3,0" />
                                            <Button Grid.Column="1" Command="{Binding SetPoseEstimateCommand}" Content="📍 Đặt vị trí tại đây" Style="{StaticResource CyberButton}" Background="#047857" Padding="6,5" Margin="3,0,0,0" ToolTip="Đặt lại vị trí của robot tại tọa độ này" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Multi-Floor Elevator Dispatch Panel -->
                                <Border Background="#0D1527" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                                    <StackPanel>
                                        <!-- Header & Toggle Settings Button -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🏢 ĐI THANG MÁY &amp; CHUYỂN TẦNG" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                                                <TextBlock Text="Chuyển map &amp; tự định vị từng tầng" FontSize="9" Foreground="#94A3B8" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding ToggleFloorConfigCommand}"
                                                    Content="{Binding FloorConfigToggleText}"
                                                    Style="{StaticResource CyberButton}" Background="#4C1D95" FontSize="9" Padding="6,3"
                                                    ToolTip="Mở/đóng bảng cài đặt Map và Điểm thang máy cho từng tầng" />
                                        </Grid>

                                        <!-- Quick Floor Buttons (Bấm số tầng để chuyển ngay) -->
                                        <TextBlock Text="Bấm số tầng để robot đi thang máy:" FontSize="9" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding FloorConfigs}" Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DispatchElevatorToFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CyberButton}" Background="#312E81" Margin="0,0,4,4" Padding="8,5"
                                                            ToolTip="{Binding MapName, StringFormat='Map: {0}'}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🛗 " FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FloorLabel}" FontSize="10" FontWeight="Bold" Foreground="#E0E7FF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Manual Floor Input Row (Tự điền số tầng thang máy) -->
                                        <Border Background="#090E1A" BorderBrush="#2E1065" BorderThickness="1" CornerRadius="5" Padding="6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Nhập tầng:" FontSize="10" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Grid.Column="1" Text="{Binding TargetFloorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26" Background="#111827" Foreground="#38BDF8" BorderBrush="#3B82F6"
                                                         FontWeight="Bold" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         ToolTip="Tự gõ số tầng (ví dụ: 1, 2, 3, B1...)" Margin="0,0,6,0" />
                                                <Button Grid.Column="2" Command="{Binding DispatchElevatorToFloorCommand}"
                                                        Content="🚀 Đi tới" Style="{StaticResource CyberButton}" Background="#7C3AED" FontSize="10" Padding="8,4"
                                                        ToolTip="Gửi lệnh robot đi thang máy đến số tầng vừa nhập" />
                                            </Grid>
                                        </Border>

                                        <!-- 2 Phím điều phối nhanh: Vào buồng thang & Bước ra sảnh -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding EnterElevatorCabinCommand}"
                                                    Content="🛗 Vào trong cabin" Style="{StaticResource CyberButton}" Background="#065F46" FontSize="10" Padding="4,5" Margin="0,0,3,0"
                                                    ToolTip="Điều hướng robot từ ngoài hành lang đi vào chính giữa buồng thang máy" />
                                            <Button Grid.Column="1" Command="{Binding ExitElevatorToHallCommand}"
                                                    Content="🚪 Lăn bánh ra sảnh" Style="{StaticResource CyberButton}" Background="#0369A1" FontSize="10" Padding="4,5" Margin="3,0,0,0"
                                                    ToolTip="Điều hướng robot từ trong thang máy bước ra điểm chờ ngoài sảnh" />
                                        </Grid>

                                        <!-- Floor Configuration Drawer (Tự set map cho Tầng 1, Tầng 2,...) -->
                                        <Border Visibility="{Binding IsFloorConfigExpanded, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#070B14" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0">
                                            <StackPanel>
                                                <TextBlock Text="⚙️ CÀI ĐẶT MAP CHO TỪNG TẦNG:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,6" />

                                                <ItemsControl ItemsSource="{Binding FloorConfigs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                            <TextBlock Text="Tên/Số tầng: " FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <TextBox Text="{Binding FloorLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="22" Background="#1E293B" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#334155" FontSize="10" Padding="3,1" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Command="{Binding DataContext.RemoveFloorConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="✕" Foreground="#EF4444" Background="Transparent" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="Xóa tầng này" />
                                                                    </Grid>

                                                                    <!-- Choose Map for this Floor -->
                                                                    <TextBlock Text="Bản đồ sử dụng:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableMaps, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding MapName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsSynchronizedWithCurrentItem="False"
                                                                              Height="24" Background="#1E293B" Foreground="#00E5FF" BorderBrush="#334155" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,0,4">
                                                                        <ComboBox.ItemContainerStyle>
                                                                            <Style TargetType="ComboBoxItem">
                                                                                <Setter Property="Background" Value="#111827" />
                                                                                <Setter Property="Foreground" Value="#E2E8F0" />
                                                                                <Setter Property="FontSize" Value="10" />
                                                                            </Style>
                                                                        </ComboBox.ItemContainerStyle>
                                                                    </ComboBox>

                                                                    <!-- 1. Điểm Trong Cabin (Relocalize khi đến tầng) -->
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="105" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="🛗 Trong cabin:" FontSize="9" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" ToolTip="Vị trí bên trong buồng thang máy (Dùng để ĐỊNH VỊ LẠI khi vừa lên/xuống tới tầng này)" />
                                                                        <TextBox Grid.Column="1" Text="{Binding InsideCabinPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="22" Background="#111827" Foreground="#34D399" BorderThickness="1" BorderBrush="#059669" FontSize="10" Padding="4,2" ToolTip="Tên điểm trong buồng thang máy (ví dụ: TrongThangMay_T1, TrongThangMay_T2) để định vị lại" />
                                                                    </Grid>

                                                                    <!-- 2. Điểm Chờ Ngoài Sảnh (Đón & Thoát thang) -->
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="105" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="🚪 Chờ ngoài sảnh:" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" ToolTip="Vị trí đứng chờ ngoài hành lang cách cửa thang 1.5m - 2m (Dùng để đón thang &amp; thoát ra khỏi thang)" />
                                                                        <TextBox Grid.Column="1" Text="{Binding OutsideWaitingPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="22" Background="#111827" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#0284C7" FontSize="10" Padding="4,2" ToolTip="Tên điểm ngoài sảnh (ví dụ: ChoThangMay_T1, ChoThangMay_T2) để chờ/thoát thang" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Command="{Binding AddFloorConfigCommand}" Content="➕ Thêm tầng" Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="9" Padding="6,4" Margin="0,0,3,0" />
                                                    <Button Grid.Column="1" Command="{Binding SaveFloorConfigsCommand}" Content="💾 Lưu cài đặt" Style="{StaticResource CyberButton}" Background="#065F46" FontSize="9" Padding="6,4" Margin="3,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Usage Tip -->
                                <Border Background="#0C1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="💡 Mẹo thao tác:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4" />
                                        <TextBlock Text="• Bấm vào bất kỳ đâu trên mặt sàn bản đồ để robot tự đi tới điểm đó." FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        <TextBlock Text="• Cuộn chuột để Phóng to / Thu nhỏ." FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        <TextBlock Text="• Giữ chuột trái/phải và rê để Di chuyển góc nhìn." FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- VIEW 3: FOOD DELIVERY TASKS FOR 3 TRAYS (GIAO THỨC ĂN)    -->
            <!-- ========================================================= -->
            <Grid Visibility="{Binding TasksVisibility}">
                <Grid.RowDefinitions>
                    <!-- Top Toolbar for Tasks -->
                    <RowDefinition Height="Auto" />
                    <!-- Main Tasks Workspace (Form Editor + Task Queue) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ROW 0: TASKS TOP TOOLBAR -->
                <Border Grid.Row="0" Style="{StaticResource AgnixCard}" Margin="0,0,0,12" Padding="12,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ShowDashboardCommand}" Style="{StaticResource CyberButton}" Content="⬅️ Dashboard" Margin="0,0,14,0" Padding="10,5" ToolTip="Quay về bảng điều khiển tổng quan" />
                            <TextBlock Text="🍱 NHIỆM VỤ GIAO THỨC ĂN (3 KHAY ROBOT)" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />

                            <Border Background="#162238" CornerRadius="4" Padding="8,4" Margin="14,0,8,0">
                                <TextBlock Text="{Binding DeliveryTasks.Count, StringFormat='Đang có {0} nhiệm vụ'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </Border>

                            <Border Background="#064E3B" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding RobotState, StringFormat='Robot: {0}'}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Right Control Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding ResetTaskFormCommand}" Content="➕ Tạo nhiệm vụ mới" Style="{StaticResource CyanButton}" Padding="10,5" Margin="0,0,6,0" ToolTip="Mở form tạo mới nhiệm vụ giao món 3 khay" />
                            <Button Command="{Binding LoadDeliveryTasksFromDiskCommand}" Content="🔄 Tải lại" Style="{StaticResource CyberButton}" Padding="8,5" Margin="0,0,6,0" ToolTip="Đọc lại danh sách nhiệm vụ từ ổ cứng" />
                            <Button Command="{Binding AbortDeliveryCommand}" Content="⏹ Dừng giao hàng" Padding="10,5" ToolTip="Dừng khẩn cấp tiến trình giao hàng đang chạy">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EmergencyRedButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeliveryRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: WORKSPACE (2 COLUMNS: TASK EDITOR & TASK QUEUE) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Form Editor (Thêm & Sửa) -->
                        <ColumnDefinition Width="430" />
                        <!-- Task List & Live Monitor -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============================================== -->
                    <!-- COLUMN 0: FORM SOẠN THẢO NHIỆM VỤ (THÊM / SỬA) -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0" Style="{StaticResource AgnixCard}" Margin="0,0,12,0" Padding="12" BorderBrush="#00E5FF" BorderThickness="1.2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Header Badge -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TaskEditorHeader}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding FormTaskId}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    </Border>
                                </Grid>

                                <!-- Task Name -->
                                <TextBlock Text="Tên nhiệm vụ giao hàng:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3" />
                                <TextBox Text="{Binding FormTaskName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,0,10" FontWeight="SemiBold" />

                                <!-- SECTION: 3 TRAYS CONFIGURATION -->
                                <Border Background="#090E17" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🍱 CẤU HÌNH 3 KHAY ROBOT:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8" />

                                        <!-- ================= KHAY 1 (TRÊN CÙNG) ================= -->
                                        <Border Background="#0E1726" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding FormTray1HasDish}" Margin="0,0,0,6">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="🍱 KHAY 1 (TẦNG TRÊN CÙNG)" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                                                    </CheckBox.Content>
                                                </CheckBox>

                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Table Combobox -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Bàn đến:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                        <ComboBox ItemsSource="{Binding AvailableStationNames}" Text="{Binding FormTray1Destination, Mode=TwoWay}" IsEditable="True" Height="26" Background="#111827" Foreground="#38BDF8" BorderBrush="#334155" FontSize="10" VerticalContentAlignment="Center" />
                                                    </StackPanel>
                                                    <!-- Dish Name -->
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Tên món ăn:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding FormTray1DishName, Mode=TwoWay}" Height="26" Background="#090D16" Foreground="#FFFFFF" BorderBrush="#334155" FontSize="10.5" VerticalContentAlignment="Center" Padding="4,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Ghi chú (bếp/khách):" FontSize="8.5" Foreground="#64748B" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding FormTray1Note, Mode=TwoWay}" Height="22" Background="#090D16" Foreground="#94A3B8" BorderBrush="#1E293B" FontSize="9.5" VerticalContentAlignment="Center" Padding="4,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- ================= KHAY 2 (Ở GIỮA) ================= -->
                                        <Border Background="#0E1726" BorderBrush="#059669" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding FormTray2HasDish}" Margin="0,0,0,6">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="🍱 KHAY 2 (TẦNG Ở GIỮA)" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                                                    </CheckBox.Content>
                                                </CheckBox>

                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Bàn đến:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                        <ComboBox ItemsSource="{Binding AvailableStationNames}" Text="{Binding FormTray2Destination, Mode=TwoWay}" IsEditable="True" Height="26" Background="#111827" Foreground="#34D399" BorderBrush="#334155" FontSize="10" VerticalContentAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Tên món ăn:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding FormTray2DishName, Mode=TwoWay}" Height="26" Background="#090D16" Foreground="#FFFFFF" BorderBrush="#334155" FontSize="10.5" VerticalContentAlignment="Center" Padding="4,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Ghi chú:" FontSize="8.5" Foreground="#64748B" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding FormTray2Note, Mode=TwoWay}" Height="22" Background="#090D16" Foreground="#94A3B8" BorderBrush="#1E293B" FontSize="9.5" VerticalContentAlignment="Center" Padding="4,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- ================= KHAY 3 (DƯỚI CÙNG) ================= -->
                                        <Border Background="#0E1726" BorderBrush="#D97706" BorderThickness="1" CornerRadius="5" Padding="8">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding FormTray3HasDish}" Margin="0,0,0,6">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="🍱 KHAY 3 (TẦNG DƯỚI CÙNG)" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                                                    </CheckBox.Content>
                                                </CheckBox>

                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Bàn đến:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                        <ComboBox ItemsSource="{Binding AvailableStationNames}" Text="{Binding FormTray3Destination, Mode=TwoWay}" IsEditable="True" Height="26" Background="#111827" Foreground="#FBBF24" BorderBrush="#334155" FontSize="10" VerticalContentAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Tên món ăn:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding FormTray3DishName, Mode=TwoWay}" Height="26" Background="#090D16" Foreground="#FFFFFF" BorderBrush="#334155" FontSize="10.5" VerticalContentAlignment="Center" Padding="4,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Ghi chú:" FontSize="8.5" Foreground="#64748B" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding FormTray3Note, Mode=TwoWay}" Height="22" Background="#090D16" Foreground="#94A3B8" BorderBrush="#1E293B" FontSize="9.5" VerticalContentAlignment="Center" Padding="4,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION: ROUTE & ROBOT SETTINGS -->
                                <Border Background="#090E17" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ THIẾT LẬP VẬN HÀNH &amp; GIỌNG NÓI:" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Trạm quay về sau khi xong:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                <ComboBox ItemsSource="{Binding AvailableStationNames}" Text="{Binding FormReturnStation, Mode=TwoWay}" IsEditable="True" Height="26" Background="#111827" Foreground="#00E5FF" BorderBrush="#334155" FontSize="10" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Dừng chờ (giây):" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding FormWaitTimeSeconds, Mode=TwoWay}" Height="26" Background="#090D16" Foreground="#F59E0B" BorderBrush="#334155" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Lời chào TTS khi robot tới bàn:" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding FormGreetingSpeech, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="42" Background="#090D16" Foreground="#E2E8F0" BorderBrush="#1E293B" FontSize="10" Padding="4" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Save Button (Add or Update) -->
                                    <Button Grid.Column="0" Command="{Binding SaveTaskCommand}" Content="💾 Lưu nhiệm vụ" Style="{StaticResource CyberButton}" Background="#059669" FontSize="11" FontWeight="Bold" Padding="10,8" Margin="0,0,4,0" ToolTip="Lưu thông tin nhiệm vụ vào danh sách và lưu xuống ổ cứng" />

                                    <!-- Cancel Edit (if in edit mode) -->
                                    <Button Grid.Column="1" Command="{Binding CancelEditTaskCommand}" Content="✕ Hủy sửa" Background="#334155" FontSize="10" Padding="8,8" Margin="0,0,4,0" ToolTip="Hủy chế độ sửa và quay lại tạo mới">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CyberButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingExistingTask}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Reset / Clear Form -->
                                    <Button Grid.Column="2" Command="{Binding ResetTaskFormCommand}" Content="➕ Làm mới" Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="10" Padding="8,8" ToolTip="Xóa trắng form để tạo nhiệm vụ mới" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ========================================================== -->
                    <!-- COLUMN 1: DANH SÁCH NHIỆM VỤ & THEO DÕI GIAO HÀNG LIVE     -->
                    <!-- ========================================================== -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <!-- Live Monitor Card (khi đang giao hàng) -->
                            <RowDefinition Height="Auto" />
                            <!-- Saved Task List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- LIVE DELIVERY MONITOR BANNER -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Background="#0C1527" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeliveryRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🚀 ĐANG THỰC THI GIAO HÀNG:" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                                        <TextBlock Text="{Binding ActiveRunningTask.TaskName}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="6,0,0,0" />
                                        <Border Background="#059669" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ActiveRunningTask.Id}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeliveryProgressStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding AbortDeliveryCommand}" Content="⏹ Hủy giao hàng" Style="{StaticResource EmergencyRedButton}" FontSize="11" Padding="12,6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- TASK QUEUE LIST -->
                        <Border Grid.Row="1" Style="{StaticResource AgnixCard}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Bar for Task List -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋 DANH SÁCH NHIỆM VỤ GIAO THỨC ĂN" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" />
                                        <TextBlock Text="(Bấm 'Bắt đầu giao' để robot chạy tuần tự qua các bàn)" FontSize="10" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Items List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DeliveryTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0C1322" BorderBrush="#1E2A3E" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <!-- Row 0: Top Info & Status -->
                                                            <RowDefinition Height="Auto" />
                                                            <!-- Row 1: 3 Tray Mini Cards -->
                                                            <RowDefinition Height="Auto" />
                                                            <!-- Row 2: Route & Action Buttons -->
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Header -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" />
                                                                </Border>
                                                                <TextBlock Text="{Binding TaskName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{} - {0:HH:mm dd/MM}'}" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="3" Padding="6,2" Opacity="0.9">
                                                                <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="#000000" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 1: 3 Tray Mini Cards -->
                                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Tray 1 Card -->
                                                            <Border Grid.Column="0" Background="#09101C" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,4,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="🍱 Khay 1 (Trên)" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2" />
                                                                    <TextBlock Text="{Binding Tray1.DisplaySummary}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Tray1.Note}" FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Tray 2 Card -->
                                                            <Border Grid.Column="1" Background="#09101C" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2,0,2,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="🍱 Khay 2 (Giữa)" FontSize="9" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,2" />
                                                                    <TextBlock Text="{Binding Tray2.DisplaySummary}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Tray2.Note}" FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Tray 3 Card -->
                                                            <Border Grid.Column="2" Background="#09101C" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="6" Margin="4,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="🍱 Khay 3 (Dưới)" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,2" />
                                                                    <TextBlock Text="{Binding Tray3.DisplaySummary}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Tray3.Note}" FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 2: Route & Action Buttons -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Lộ trình: " FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding TrayRouteOverview}" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ReturnStation, StringFormat='{} ➔ Về: {0}'}" FontSize="9.5" Foreground="#A78BFA" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            </StackPanel>

                                                            <!-- Action Buttons: Dispatch, Edit, Delete -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Dispatch Delivery -->
                                                                <Button Command="{Binding DataContext.DispatchDeliveryTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                        CommandParameter="{Binding}"
                                                                        Content="🚀 Bắt đầu giao" Style="{StaticResource CyanButton}" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="0,0,4,0" ToolTip="Gửi lệnh điều khiển robot bắt đầu giao các khay theo thứ tự" />

                                                                <!-- Edit Task -->
                                                                <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                        CommandParameter="{Binding}"
                                                                        Content="✏️ Sửa" Style="{StaticResource CyberButton}" Background="#D97706" FontSize="10" Padding="8,5" Margin="0,0,4,0" ToolTip="Nạp nhiệm vụ này vào bảng bên trái để chỉnh sửa" />

                                                                <!-- Delete Task -->
                                                                <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                        CommandParameter="{Binding}"
                                                                        Content="🗑️ Xóa" Style="{StaticResource CyberButton}" Background="#7F1D1D" Foreground="#FCA5A5" FontSize="10" Padding="8,5" ToolTip="Xóa nhiệm vụ này khỏi danh sách" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- COLUMN 2: RIGHT PANEL (ROBOT CARDS, ALERTS, TELEOPERATION)-->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,14,16,14">
            <StackPanel>

                <!-- CONNECTION & NETWORK DIAGNOSTIC TOOLBAR (Direct Help for Connection) -->
                <Border Style="{StaticResource AgnixCard}" Margin="0,0,0,12" BorderBrush="#00E5FF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📡 KẾT NỐI &amp; CHẨN ĐOÁN ROBOT" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding RobotIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding RobotPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" />
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding RunDiagnosticCommand}" Content="Kiểm tra Ping/Port" Margin="0,0,4,0" Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="11" />
                            <Button Grid.Column="1" Command="{Binding ScanSubnetCommand}" Content="Quét mạng LAN" Margin="4,0,0,0" Style="{StaticResource CyberButton}" Background="#1E293B" FontSize="11" />
                        </Grid>

                        <Button Command="{Binding ToggleConnectionCommand}" Content="{Binding ConnectionStatusText}" Style="{StaticResource CyanButton}" Height="34" Margin="0,0,0,6" />

                        <!-- Diagnostic Message Banner -->
                        <TextBlock Text="{Binding DiagnosticMessage}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- CARD: QUẢN LÝ BẢN ĐỒ (MAPS) - VỊ TRÍ CỘT PHẢI THEO YÊU CẦU -->
                <Border Style="{StaticResource AgnixCard}" Margin="0,0,0,12" BorderBrush="#00E5FF" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗺️ QUẢN LÝ BẢN ĐỒ (MAPS)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" />
                            </StackPanel>
                            <Button Command="{Binding RefreshMapCommand}" Content="🔄 Làm mới" HorizontalAlignment="Right" Style="{StaticResource CyberButton}" FontSize="10" Padding="8,3" ToolTip="Tải lại danh sách bản đồ từ robot" />
                        </Grid>

                        <!-- Map Selection ComboBox & Switch Button -->
                        <TextBlock Text="Chọn bản đồ robot:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#111827" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                                <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding SelectedMap}" Height="28" Background="#111827" Foreground="#00E5FF" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#111827" />
                                            <Setter Property="Foreground" Value="#E2E8F0" />
                                            <Setter Property="Padding" Value="6,4" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Border>

                            <Button Grid.Column="1" Command="{Binding SwitchMapCommand}" Content="Đổi Map" Width="72" Height="28" Style="{StaticResource CyanButton}" FontSize="11" FontWeight="Bold" />
                        </Grid>

                        <!-- Current Map Info Badge -->
                        <Border Background="#161B28" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentMap, StringFormat='Bản đồ hiện tại: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AvailableMaps.Count, StringFormat='Đã tải {0} bản đồ từ robot'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Places / Stations Quick Navigation List -->
                        <TextBlock Text="Điểm đến trên bản đồ (Stations):" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding MapStations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding Name}" 
                                            Margin="0,0,6,6" Background="#162034" BorderBrush="#00E5FF" BorderThickness="1" Padding="7,4" Cursor="Hand"
                                            ToolTip="{Binding Name, StringFormat='Bấm để robot di chuyển đến {0}'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="10" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- LIVE ROBOT CARDS (From AgniX Mockup: ROB01, ROB02, ROB03, ROB04) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ROB01 Card -->
                    <Border Grid.Column="0" Style="{StaticResource AgnixCard}" Margin="0,0,6,6" Background="#111827">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding RobotId}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding ConnectionStatusText, StringFormat='● {0}'}" HorizontalAlignment="Right" FontSize="10" Foreground="#10B981" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="🏎️" FontSize="26" HorizontalAlignment="Right" Margin="0,2,0,2" />
                            <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0} %'}" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" />
                            <TextBlock Text="{Binding RobotState, StringFormat='Trạng thái: {0}'}" FontSize="9" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- ROB02 Card -->
                    <Border Grid.Column="1" Style="{StaticResource AgnixCard}" Margin="6,0,0,6" Background="#111827">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ROB02" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                <TextBlock Text="● Active" HorizontalAlignment="Right" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="🏎️" FontSize="26" HorizontalAlignment="Right" Margin="0,2,0,2" />
                            <TextBlock Text="96 %" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Last updated" FontSize="9" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ROB03 Card (With Mission Info) -->
                    <Border Grid.Column="0" Style="{StaticResource AgnixCard}" Margin="0,0,6,0" Background="#111827">
                        <StackPanel>
                            <TextBlock Text="ROB03" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="TO-213 · Jule" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,2" />
                            <TextBlock Text="Transport loaded container to Area C" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                            <ProgressBar Value="72" Maximum="100" Height="4" Background="#1C273C" Foreground="#F59E0B" BorderThickness="0" Margin="0,6,0,2" />
                            <TextBlock Text="72 %" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" />
                        </StackPanel>
                    </Border>

                    <!-- ROB04 Card -->
                    <Border Grid.Column="1" Style="{StaticResource AgnixCard}" Margin="6,0,0,0" Background="#111827">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ROB04" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                <TextBlock Text="● Idle" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B" />
                            </Grid>
                            <TextBlock Text="🏎️" FontSize="26" HorizontalAlignment="Right" Margin="0,2,0,2" />
                            <ProgressBar Value="45" Maximum="100" Height="4" Background="#1C273C" Foreground="#F59E0B" BorderThickness="0" Margin="0,6,0,2" />
                            <TextBlock Text="45 %" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RECENT ALERTS PANEL (Identical to AgniX photo) -->
                <Border Style="{StaticResource AgnixCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Recent Alerts" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Select 22 Alerts" HorizontalAlignment="Right" FontSize="10" Foreground="#38BDF8" Cursor="Hand" />
                        </Grid>

                        <!-- Alerts List -->
                        <StackPanel>
                            <!-- Alert 1 -->
                            <Border Background="#161B28" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Low Battery Warning" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                    </StackPanel>
                                    <TextBlock Text="Robot 04 battery below 50%" FontSize="9" Foreground="#64748B" Margin="12,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Alert 2 -->
                            <Border Background="#161B28" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Route Obstruction" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                    </StackPanel>
                                    <TextBlock Text="Lane Upstream 30cm clearance" FontSize="9" Foreground="#64748B" Margin="12,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Alert 3 -->
                            <Border Background="#161B28" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Route Obstruction Cleared" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                    </StackPanel>
                                    <TextBlock Text="Resuming delivery path" FontSize="9" Foreground="#64748B" Margin="12,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Alert 4 -->
                            <Border Background="#161B28" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="CoreService Link Status" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                    </StackPanel>
                                    <TextBlock Text="OrionStar hardware API online" FontSize="9" Foreground="#64748B" Margin="12,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TELEOPERATION D-PAD & E-STOP CONTROLS -->
                <Border Style="{StaticResource AgnixCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🕹️ BÀN ĐIỀU KHIỂN TỪ XA" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10" />

                        <!-- D-Pad (Giữ chuột để chạy, thả ra tự dừng an toàn) -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Command="{Binding MoveCommand}" CommandParameter="FORWARD" Content="▲ TIẾN" Width="85" Height="36" Margin="0,0,0,4" Style="{StaticResource CyberButton}" PreviewMouseDown="OnDirectionButtonDown" PreviewMouseUp="OnDirectionButtonUp" MouseLeave="OnDirectionButtonUp" ToolTip="Bấm giữ để tiến, nhả ra tự dừng" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding MoveCommand}" CommandParameter="TURN_LEFT" Content="◄" Width="42" Height="36" Margin="0,0,4,0" Style="{StaticResource CyberButton}" PreviewMouseDown="OnDirectionButtonDown" PreviewMouseUp="OnDirectionButtonUp" MouseLeave="OnDirectionButtonUp" ToolTip="Bấm giữ để quay trái" />
                                <Button Command="{Binding MoveCommand}" CommandParameter="STOP" Content="■ DỪNG" Width="60" Height="36" Margin="0,0,4,0" Style="{StaticResource CyberButton}" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" ToolTip="Dừng ngay lập tức" />
                                <Button Command="{Binding MoveCommand}" CommandParameter="TURN_RIGHT" Content="►" Width="42" Height="36" Style="{StaticResource CyberButton}" PreviewMouseDown="OnDirectionButtonDown" PreviewMouseUp="OnDirectionButtonUp" MouseLeave="OnDirectionButtonUp" ToolTip="Bấm giữ để quay phải" />
                            </StackPanel>
                            <Button Command="{Binding MoveCommand}" CommandParameter="BACKWARD" Content="▼ LÙI" Width="85" Height="36" Margin="0,4,0,0" Style="{StaticResource CyberButton}" PreviewMouseDown="OnDirectionButtonDown" PreviewMouseUp="OnDirectionButtonUp" MouseLeave="OnDirectionButtonUp" ToolTip="Bấm giữ để lùi, nhả ra tự dừng" />
                        </StackPanel>

                        <!-- Speed Slider -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tốc độ di chuyển:" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding LinearSpeed, StringFormat={}{0:F1} m/s}" HorizontalAlignment="Right" FontSize="11" Foreground="#00E5FF" FontWeight="Bold" />
                        </Grid>
                        <Slider Value="{Binding LinearSpeed}" Minimum="0.1" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,12" />

                        <!-- BIG E-STOP -->
                        <Button Command="{Binding EmergencyStopCommand}" Content="⛔ DỪNG KHẨN CẤP (E-STOP)" Height="42" Style="{StaticResource EmergencyRedButton}" />
                    </StackPanel>
                </Border>

                <!-- AI SPEECH & QUICK ACTIONS -->
                <Border Style="{StaticResource AgnixCard}">
                    <StackPanel>
                        <TextBlock Text="🗣️ PHÁT GIỌNG NÓI TIẾNG VIỆT" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SpeechText, UpdateSourceTrigger=PropertyChanged}" Height="48" TextWrapping="Wrap" Style="{StaticResource CyberTextBox}" Margin="0,0,0,8" />
                        <Button Command="{Binding SpeakCommand}" Content="🔊 Phát giọng nói" Style="{StaticResource CyanButton}" Height="30" Margin="0,0,0,8" />

                        <!-- Quick Service Commands -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ChargeCommand}" CommandParameter="START_CHARGE" Content="⚡ Về trạm sạc" Margin="0,0,3,0" Style="{StaticResource CyberButton}" Background="#D97706" FontSize="10" />
                            <Button Grid.Column="1" Command="{Binding ChargeCommand}" CommandParameter="LEAVE_PILE" Content="Rời dock sạc" Margin="3,0,0,0" Style="{StaticResource CyberButton}" FontSize="10" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ControlDoorCommand}" CommandParameter="OPEN" Content="Mở khoang" Margin="0,0,3,0" Style="{StaticResource CyberButton}" FontSize="10" />
                            <Button Grid.Column="1" Command="{Binding ControlDoorCommand}" CommandParameter="CLOSE" Content="Đóng khoang" Margin="3,0,0,0" Style="{StaticResource CyberButton}" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
